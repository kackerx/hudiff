.rvi.wontfix .cb{background:var(--del-fg);border-color:var(--del-fg)}
.rvi .acts{grid-column:2;display:flex;gap:6px;opacity:0;transition:opacity .12s} .rvi:hover .acts{opacity:1}
.rvi .notes{grid-column:2;display:flex;flex-direction:column;gap:4px}
