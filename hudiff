# ─── 小工具 ──────────────────────────────────────────────────────────────────

def die(msg, code=1):
    print(f"hudiff: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, cwd=None, input=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, input=input, text=True, capture_output=True)
    if check and p.returncode != 0:
        die(f"{shlex.join(cmd)} 失败:\n{p.stderr.strip()}")
    return p.stdout


def git(*args, cwd=None, check=True):
    return run(["git", "--no-pager", *args], cwd=cwd, check=check)


def repo_root():
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"], text=True, capture_output=True)
    if p.returncode != 0:
        die("当前目录不在 git 仓库里(要看任意补丁请用 --patch)")
    return p.stdout.strip()


def read_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except FileNotFoundError:
        return default


def write_json(path, obj):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(obj, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


# ─── 取 diff: 各种来源统一成 {kind, title, meta, patch} ──────────────────────

PR_URL = re.compile(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)")


def source_from_args(a):
    """把 open 的参数翻成一个 source dict。patch 是 git 风格的 unified diff 文本。"""
    diff_flags = ["--no-color", "--no-ext-diff", "-M", "-U3"]
    tgt = list(a.target)

    if a.patch:
        text = sys.stdin.read() if a.patch == "-" else Path(a.patch).read_text()
        return dict(kind="patch", title=a.title or ("补丁: " + a.patch), meta={"source": a.patch},
                    patch=text, repo=os.getcwd(), refresh=None)

    root = repo_root()
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=root).strip()
    head = git("rev-parse", "--short", "HEAD", cwd=root).strip()

    # PR: pr 123 / #123 / URL
    if tgt and (tgt[0] in ("pr", "PR") or tgt[0].startswith("#") or PR_URL.search(tgt[0])):
        if tgt[0] in ("pr", "PR"):
            if len(tgt) < 2:
                die("pr 后面要跟编号")
            num = tgt[1]
        elif tgt[0].startswith("#"):
            num = tgt[0][1:]
        else:
            num = PR_URL.search(tgt[0]).group(3)
        if not shutil.which("gh"):
            die("看 PR 需要 gh CLI")
        info = json.loads(run(["gh", "pr", "view", num, "--json",
                               "number,title,body,url,baseRefName,headRefName,author,additions,deletions"], cwd=root))
        patch = run(["gh", "pr", "diff", num], cwd=root)
        return dict(kind="pr", title=a.title or f"#{info['number']} {info['title']}",
                    meta={"url": info["url"], "base": info["baseRefName"], "head": info["headRefName"],
                          "author": (info.get("author") or {}).get("login"), "body": info.get("body") or ""},
                    patch=patch, repo=root, refresh=["pr", num])

    if a.staged:
        patch = git("diff", *diff_flags, "--cached", cwd=root)
        return dict(kind="worktree", title=a.title or "已暂存的改动",
                    meta={"base": head, "branch": branch, "scope": "staged"},
                    patch=patch, repo=root, refresh=["--staged"])
    if a.unstaged:
        patch = git("diff", *diff_flags, cwd=root)
        return dict(kind="worktree", title=a.title or "未暂存的改动",
                    meta={"base": head, "branch": branch, "scope": "unstaged"},
                    patch=patch, repo=root, refresh=["--unstaged"])
    if not tgt:
        patch = git("diff", *diff_flags, "HEAD", cwd=root)
        return dict(kind="worktree", title=a.title or "工作区未提交的改动",
                    meta={"base": head, "branch": branch, "scope": "worktree"},
                    patch=patch, repo=root, refresh=[])

    spec = " ".join(tgt)
    if ".." in spec:
        patch = git("diff", *diff_flags, spec, cwd=root)
        a_, b_ = re.split(r"\.{2,3}", spec, maxsplit=1)
        return dict(kind="range", title=a.title or f"{spec}",
                    meta={"base": a_, "head": b_ or "HEAD", "branch": branch},
                    patch=patch, repo=root, refresh=[spec])

    # 单个 commit
    rev = git("rev-parse", "--verify", spec + "^{commit}", cwd=root, check=False).strip()
    if not rev:
        die(f"无法解析 {spec!r}: 不是 commit、区间, 也不是 PR")
    parents = git("rev-list", "--parents", "-n1", rev, cwd=root).split()[1:]
    if parents:
        patch = git("diff", *diff_flags, parents[0], rev, cwd=root)
    else:
        patch = git("diff-tree", "-p", "--root", *diff_flags, rev, cwd=root)
    log = git("log", "-1", "--format=%h%x00%s%x00%an%x00%ad%x00%b", "--date=short", rev, cwd=root)
    short, subject, author, date, body = log.split("\x00", 4)
    return dict(kind="commit", title=a.title or subject,
                meta={"rev": short, "full": rev, "author": author, "date": date, "body": body.strip(),
                      "base": (parents[0][:7] if parents else None), "merge": len(parents) > 1},
                patch=patch, repo=root, refresh=[spec])


# ─── unified diff 解析 ────────────────────────────────────────────────────────

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@ ?(.*)$")


def parse_patch(text):
    files, cur, hunk = [], None, None
    old = new = 0
    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            hunk = None
            cur = dict(path=None, old_path=None, status="M", binary=False, hunks=[], add=0, del_=0)
            m = re.match(r"^diff --git a/(.*) b/(.*)$", raw)
            if m:
                cur["old_path"], cur["path"] = m.group(1), m.group(2)
            files.append(cur)
            continue
        if cur is None:
            continue
        if hunk is None:
            if raw.startswith("new file mode"):
                cur["status"] = "A"
            elif raw.startswith("deleted file mode"):
                cur["status"] = "D"
            elif raw.startswith("rename from "):
                cur["old_path"] = raw[len("rename from "):]
                cur["status"] = "R"
            elif raw.startswith("rename to "):
                cur["path"] = raw[len("rename to "):]
            elif raw.startswith("Binary files") or raw.startswith("GIT binary patch"):
                cur["binary"] = True
            elif raw.startswith("--- "):
                p = raw[4:]
                if p != "/dev/null":
                    cur["old_path"] = p[2:] if p.startswith("a/") else p
            elif raw.startswith("+++ "):
                p = raw[4:]
                if p != "/dev/null":
                    cur["path"] = p[2:] if p.startswith("b/") else p
        m = HUNK_RE.match(raw)
        if m:
            old, new = int(m.group(1)), int(m.group(3))
            hunk = dict(header=raw, old_start=old, old_count=int(m.group(2) or 1),
                        new_start=new, new_count=int(m.group(4) or 1),
                        section=m.group(5), lines=[])
            cur["hunks"].append(hunk)
            continue
        if hunk is None:
            continue
        if raw.startswith("\\"):           # "\ No newline at end of file"
            if hunk["lines"]:
                hunk["lines"][-1]["nonl"] = True
            continue
        t = raw[0] if raw else " "
        s = raw[1:]
        if t == " ":
            hunk["lines"].append(dict(t=" ", o=old, n=new, s=s)); old += 1; new += 1
        elif t == "+":
            hunk["lines"].append(dict(t="+", o=None, n=new, s=s)); new += 1; cur["add"] += 1
        elif t == "-":
            hunk["lines"].append(dict(t="-", o=old, n=None, s=s)); old += 1; cur["del_"] += 1
        else:                              # 不认识的行(比如 diff 结尾的杂项), 当 hunk 结束
            hunk = None
    for f in files:
        f["del"] = f.pop("del_")
        if f["path"] is None:
            f["path"] = f["old_path"]
    return files


# ─── 会话 ────────────────────────────────────────────────────────────────────

def session_dir(sid):
    return SESSIONS / sid


def sessions_for_repo(root):
    out = []
    if SESSIONS.is_dir():
        for p in SESSIONS.iterdir():
            sj = read_json(p / "session.json", None)
            if sj and sj.get("repo") == root and not sj.get("archived"):
                out.append(sj)
    return sorted(out, key=lambda x: x["id"], reverse=True)


def current_session(explicit=None):
    """--session 给了就用它; 否则优先【当前仓库】最近一次 open 的会话(多个 CC 实例在不同
    仓库里各开各的时互不干扰), 不在仓库里才退回全局 current。"""
    sid = explicit
    if not sid:
        p = subprocess.run(["git", "rev-parse", "--show-toplevel"], text=True, capture_output=True)
        if p.returncode == 0:
            mine = sessions_for_repo(p.stdout.strip())
            if mine:
                sid = mine[0]["id"]
    if not sid:
        try:
            sid = CURRENT.read_text().strip()
        except FileNotFoundError:
            die("还没有会话, 先 hudiff open")
    d = session_dir(sid)
    if not d.is_dir():
        die(f"会话不存在: {sid}")
    return sid, d


def load(d):
    return (read_json(d / "session.json", {}), read_json(d / "diff.json", {"files": []}),
            read_json(d / "notes.json", {}), read_json(d / "comments.json", []))


PROMPTS_DIR = Path(os.environ.get("HUDIFF_PROMPTS") or Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser() / "hudiff").expanduser()


def build_brief(a, repo):
    """审查要求 = 预设文件(default.md + <仓库名>.md) + 命令行 --prompt + --context 路径。
    只是原文透传给 agent(show / open --json 里能看到), 页面头部也显示; 工具本身不解释它。"""
    presets = []
    for name in ("default.md", f"{os.path.basename(repo)}.md"):
        f = PROMPTS_DIR / name
        if f.is_file():
            presets.append(dict(path=str(f), text=f.read_text().strip()))
    prompt = (a.prompt or "").strip()
    if prompt == "-":
        prompt = sys.stdin.read().strip()
    ctx = []
    for c in (a.context or []):
        cp = Path(c).expanduser()
        if not cp.is_absolute():
            cp = Path(repo) / cp
        ctx.append(str(cp) + ("" if cp.exists() else "  (不存在)"))
    if not (presets or prompt or ctx):
        return None
    return dict(prompt=prompt, presets=presets, context=ctx)


def source_key(src):
    """同一仓库里指向同一个东西的 open 算同一个会话: commit 用完整 sha, 区间用两端 sha, PR 用编号,
    工作区用 scope(内容会变, 但会话是同一个, open 时顺带 refresh), 补丁用路径。"""
    repo = os.path.realpath(src["repo"])
    m = src.get("meta", {})
    if src["kind"] == "commit":
        ident = m.get("full") or m.get("rev")
    elif src["kind"] == "range":
        ident = f"{m.get('base')}..{m.get('head')}"
    elif src["kind"] == "pr":
        ident = m.get("url") or str(src.get("refresh"))
    elif src["kind"] == "worktree":
        ident = m.get("scope", "worktree")
    else:
        ident = m.get("source", "")
    return f"{src['kind']}:{repo}:{ident}"


def find_session_by_key(key):
    if not SESSIONS.is_dir():
        return None
    hits = []
    for p in SESSIONS.iterdir():
        sj = read_json(p / "session.json", None)
        if not sj or sj.get("archived"):
            continue
        k = sj.get("key")
        if not k and sj.get("repo") and sj.get("kind"):      # 老会话没存 key, 现算一个
            try:
                k = source_key(sj)
            except Exception:
                k = None
        if k == key:
            hits.append(sj)
    hits.sort(key=lambda x: x["id"], reverse=True)
    return hits[0] if hits else None


def apply_refresh(d, sess, src):
    """用新的 patch 更新会话: 说明按 hunk 头没变的文件保留, 评论按行内容重新对位。返回 (files, dropped, stale, changed)。"""
    old_diff, notes, comments = read_json(d / "diff.json", {"files": []}), read_json(d / "notes.json", {}), read_json(d / "comments.json", [])
    old_patch = (d / "diff.patch").read_text() if (d / "diff.patch").exists() else None
    if old_patch == src["patch"]:
        return old_diff["files"], [], [], False
    files = parse_patch(src["patch"])
    diff = {"files": files}
    old_by = {f["path"]: f for f in old_diff["files"]}
    dropped = []
    for path in list((notes.get("files") or {}).keys()):
        nf = next((f for f in files if f["path"] == path), None)
        of = old_by.get(path)
        same = nf and of and [h["header"] for h in nf["hunks"]] == [h["header"] for h in of["hunks"]]
        if not same:
            notes["files"].pop(path)
            dropped.append(path)
    reanchor(diff, comments)
    (d / "diff.patch").write_text(src["patch"])
    write_json(d / "diff.json", diff)
    write_json(d / "notes.json", notes)
    write_json(d / "comments.json", comments)
    shutil.rmtree(d / "diagrams", ignore_errors=True)
    stale = [c["id"] for c in comments if c.get("stale")]
    return files, dropped, stale, True


def new_session(src, brief=None):
    SESSIONS.mkdir(parents=True, exist_ok=True)
    sid = dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(2).hex()
    d = session_dir(sid)
    d.mkdir()
    files = parse_patch(src["patch"])
    if not files:
        shutil.rmtree(d)
        die("diff 是空的, 没什么可看")
    (d / "diff.patch").write_text(src["patch"])
    write_json(d / "diff.json", {"files": files})
    write_json(d / "notes.json", {})
    write_json(d / "comments.json", [])
    write_json(d / "session.json", dict(
        id=sid, kind=src["kind"], title=src["title"], meta=src["meta"], repo=src["repo"],
        refresh=src["refresh"], created=now_iso(), submit_seq=0, brief=brief, key=source_key(src),
        opener=dict(cwd=os.getcwd(), tmux_pane=os.environ.get("TMUX_PANE"),
                    claude_session=os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("PI_COMPANION_SESSION_ID"),
                    ppid=os.getppid()),
    ))
    CURRENT.write_text(sid)
    return sid, d


SERVER_JSON = STATE / "server.json"
ENV_PORT = int(os.environ["HUDIFF_PORT"]) if os.environ.get("HUDIFF_PORT", "").isdigit() else None
WANT_PORT = None          # 全局 --port 填进来


def server_info():
    return read_json(SERVER_JSON, {})


def server_alive(info=None):
    info = server_info() if info is None else info
    pid, port = info.get("pid"), info.get("port")
    if not pid or not port:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return True
    except OSError:
        return False


def ensure_server():
    """只有一个 server 进程, 管所有会话。不在就拉起, 返回端口。"""
    info = server_info()
    if server_alive(info):
        return info["port"]
    STATE.mkdir(parents=True, exist_ok=True)
    log = open(STATE / "server.log", "ab")
    cmd = [sys.executable, SELF, "serve"]
    if WANT_PORT:
        cmd += ["--port", str(WANT_PORT)]
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(60):
        time.sleep(0.05)
        info = server_info()
        if server_alive(info):
            return info["port"]
    die(f"server 没起来, 看 {STATE}/server.log")


def home_url():
    return f"http://127.0.0.1:{ensure_server()}/"


def session_url(sid):
    return f"{home_url()}s/{sid}/"


def api(sid, method, path, body=None, timeout=10):
    """走 server 的会话 API(server 是评论的唯一写者); server 不在就返回 None。"""
    info = server_info()
    if not server_alive(info):
        return None
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"http://127.0.0.1:{info['port']}/s/{sid}{path}", data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"null")


# ─── 评论的存取(server 内用; CLI 在 server 不在时直接落盘) ───────────────────

def next_comment_id(comments):
    mx = 0
    for c in comments:
        m = re.match(r"c(\d+)$", c.get("id", ""))
        if m:
            mx = max(mx, int(m.group(1)))
    return f"c{mx + 1}"


def find_line(diff, file, hunk_i, side, line):
    for f in diff["files"]:
        if f["path"] == file:
            try:
                h = f["hunks"][hunk_i]
            except (IndexError, TypeError):
                return None, None
            for ln in h["lines"]:
                if (ln["n"] if side == "new" else ln["o"]) == line and (side == "new" and ln["t"] != "-" or side == "old" and ln["t"] != "+"):
                    return h, ln
    return None, None


def reanchor(diff, comments):
    """refresh 之后按【行内容】重新对位。找不到同内容的行就标 stale, 不删。"""
    for c in comments:
        if c.get("target") != "line":
            # hunk 级评论: hunk 数量变了就标 stale
            if c.get("target") == "hunk":
                f = next((f for f in diff["files"] if f["path"] == c["file"]), None)
                c["stale"] = not (f and c["hunk"] < len(f["hunks"]))
            continue
        f = next((f for f in diff["files"] if f["path"] == c["file"]), None)
        if not f:
            c["stale"] = True
            continue
        best = None
        for hi, h in enumerate(f["hunks"]):
            for ln in h["lines"]:
                num = ln["n"] if c["side"] == "new" else ln["o"]
                if num is None or ln["s"] != c.get("snippet"):
                    continue
                if c["side"] == "new" and ln["t"] == "-" or c["side"] == "old" and ln["t"] == "+":
                    continue
                dist = abs(num - c["line"])
                if best is None or dist < best[0]:
                    best = (dist, hi, num)
        if best:
            c["hunk"], c["line"], c["stale"] = best[1], best[2], False
        else:
            c["stale"] = True
    return comments


