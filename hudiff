aside .tabs button.tab.on{background:var(--bg);color:var(--fg);font-weight:600;box-shadow:var(--shadow)}
aside .tabs .n{display:inline-block;min-width:16px;padding:0 5px;border-radius:8px;background:var(--bg3);color:var(--fg2);font-size:10.5px;line-height:16px;margin-left:4px} aside .tabs button.on .n{background:var(--accent);color:#fff}
