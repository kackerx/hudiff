def cmd_wait(a):
    sid, d = current_session(a.session)
    sess, diff, _, comments = load(d)
    pending = [c for c in comments if c["status"] == "sent"]
    if pending:
        print_comments(pending, diff, a.json, None if a.json else f"# 已有 {len(pending)} 条待处理评论(用户之前就点过发送)")
        return
    ensure_server()
    since = sess.get("submit_seq", 0)
    t_start = time.time()
    deadline = time.time() + a.timeout
    while True:
        left = deadline - time.time()
        if left <= 0:
            print(f"(等了 {a.timeout:.0f} 秒, 用户还没点「发给 agent」)", file=sys.stderr)
            sys.exit(124)
        try:
            who = os.environ.get("TMUX_PANE") or f"pid:{os.getpid()}"
            r = api(sid, "GET", f"/api/wait?since={since}&timeout={min(left, 30):.0f}&pane={urllib.parse.quote(who)}", timeout=min(left, 30) + 5)
        except (urllib.error.URLError, TimeoutError, OSError):
            r = None
        if r is None:
            # server 被重启了(改了页面之类): 等它回来, 拉不起来再放弃
            for _ in range(15):
                time.sleep(1)
                try:
                    ensure_server()
                    break
                except SystemExit:
                    continue
            else:
                die("server 断了且拉不起来", 2)
            continue
        if r["changed"]:
            break
    sess, diff, _, comments = load(d)
    pending = [c for c in comments if c["status"] == "sent"]
    rv = load_review(d)
    rv_new = rv and os.stat(d / "review.json").st_mtime > t_start
    if pending or not rv_new:
        print_comments(pending, diff, a.json, None if a.json else f"# 用户发来 {len(pending)} 条评论")
    if rv_new and not a.json:
        c = review_counts(rv)
        print(f"\n# 审查报告已更新(作者 {rv.get('author', '?')}): 待处理 {c['open']} 项(高 {c['high']} / 中 {c['medium']} / 低 {c['low']}) —— 用 `hudiff review --open` 看, 处理完 `hudiff review done <id> \"结果\"`")


