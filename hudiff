# 由【另一个】agent 写: 总体评价 / 优点 / 待处理项(高中低). 每项是一条可勾的 todo, 带文件:行,
# 讲解的 agent(或人)处理完用 `hudiff review done <id> "结果"` 打钩。schema 见 skill。

PRIO = {"high": "高优", "medium": "中优", "low": "低优"}
PRIO_ALIAS = {"高": "high", "高优": "high", "h": "high", "p0": "high", "中": "medium", "中优": "medium", "m": "medium", "p1": "medium",
              "低": "low", "低优": "low", "l": "low", "p2": "low"}


def load_review(d):
    return read_json(d / "review.json", None)


def validate_review(rv, diff):
    """规范化 + 校验。返回 (problems, rv)。会把 file:line 对到 hunk, 补 side / snippet。"""
    problems = []
    if not isinstance(rv, dict):
        return ["review 应是对象"], rv
    by_path = {f["path"]: f for f in diff["files"]}
    rv.setdefault("summary", "")
    rv.setdefault("strengths", [])
    if isinstance(rv["strengths"], str):
        rv["strengths"] = [rv["strengths"]]
    items = rv.get("items") or []
    if not isinstance(items, list):
        return ["review.items 应是数组"], rv
    seen = set()
    for i, it in enumerate(items):
        tag = f"items[{i}]"
        if not isinstance(it, dict):
            problems.append(f"{tag}: 不是对象"); continue
        pr = str(it.get("priority", "")).lower()
        pr = PRIO_ALIAS.get(pr, pr)
        if pr not in PRIO and not (it.get("note") and not it.get("title")):
            problems.append(f"{tag}: priority 只能是 high / medium / low(或 高优/中优/低优)")
        it["priority"] = pr
        it.setdefault("id", f"r{i + 1}")
        if it["id"] in seen:
            problems.append(f"{tag}: id 重复 {it['id']}")
        seen.add(it["id"])
        if it.get("note") and not it.get("title"):
            it["_note_only"] = True          # 复核项: 只对已有的 id 追加一条复核说明
            if it.get("verdict") not in (None, "ok", "disagree", "info"):
                problems.append(f"{tag}: verdict 只能是 ok / disagree / info")
            continue
        if not it.get("title"):
            problems.append(f"{tag}: 缺 title(问题一句话)")
        it.setdefault("body", "")
        it.setdefault("suggestion", "")
        it.setdefault("status", "open")
        if it["status"] not in ("open", "done", "wontfix"):
            problems.append(f"{tag}: status 只能是 open / done / wontfix")
        f = it.get("file")
        if f:
            if f not in by_path:
                problems.append(f"{tag}: 文件不在 diff 里: {f}")
                continue
            ln = it.get("line")
            if ln is not None:
                side = it.get("side") or "new"
                found = None
                for hi, h in enumerate(by_path[f]["hunks"]):
                    for l in h["lines"]:
                        if (l["n"] if side == "new" else l["o"]) == ln and not (side == "new" and l["t"] == "-") and not (side == "old" and l["t"] == "+"):
                            found = (hi, l); break
                    if found:
                        break
                if not found:
                    problems.append(f"{tag}: {f} 的{'新版' if side == 'new' else '旧版'} L{ln} 不在 diff 里(行号要用 hudiff show 里的, 新版列)")
                else:
                    it["side"], it["hunk"] = side, found[0]
                    it.setdefault("snippet", found[1]["s"])
    rv["items"] = items
    return problems, rv


def merge_review(old, new, replace=False):
    """把新一轮报告并进已有报告。默认不覆盖: 老项(含用户已打钩/拒绝的状态和处理说明)全部保留;
    新项按 id 对齐 —— 同 id 且同位置视为同一项(文字可更新, 状态不动), 同 id 不同位置则给新 id;
    老报告里有、新报告里没提的项也留着。每一项记 round(第几轮提出), 顶层 rounds[] 记每轮的作者/时间/总评。"""
    if replace or not old:
        rnd = 1
        new["items"] = [it for it in new.get("items", []) if not it.pop("_note_only", False)]
        for it in new["items"]:
            it.setdefault("round", rnd)
            if it.get("note"):
                it.setdefault("notes", []).append(dict(who=new.get("author") or "reviewer", round=rnd, body=it.pop("note"), verdict=it.pop("verdict", "info"), ts=now_iso()))
        new["rounds"] = [dict(round=rnd, author=new.get("author"), at=now_iso(), summary=new.get("summary", ""),
                              strengths=new.get("strengths", []), added=len(new.get("items", [])))]
        return new
    if not old.get("rounds"):            # 老格式的报告(还没有轮次记录): 把它整体当第 1 轮
        old["rounds"] = [dict(round=1, author=old.get("author"), at=old.get("updated"), summary=old.get("summary", ""),
                              strengths=old.get("strengths", []), added=len(old.get("items", [])))]
        for it in old.get("items", []):
            it.setdefault("round", 1)
    rnd = len(old["rounds"]) + 1
    items = list(old.get("items", []))
    by_id = {it["id"]: it for it in items}
    used = set(by_id)
    added, updated = 0, 0

    def loc(it):
        return (it.get("file"), it.get("line"), it.get("side", "new"))

    def free_id(base):
        n = 1
        while f"r{n}" in used:
            n += 1
        return f"r{n}"

    noted = 0
    for it in new.get("items", []):
        it["round"] = rnd
        if it.pop("_note_only", False):
            cur = by_id.get(it["id"])
            if cur:
                cur.setdefault("notes", []).append(dict(who=new.get("author") or "reviewer", round=rnd, body=it["note"],
                                                        verdict=it.get("verdict") or "info", ts=now_iso()))
                noted += 1
            continue
        if it.get("note"):
            it.setdefault("notes", []).append(dict(who=new.get("author") or "reviewer", round=rnd, body=it.pop("note"), verdict=it.pop("verdict", "info"), ts=now_iso()))
        cur = by_id.get(it["id"])
        if not (cur and loc(cur) == loc(it)):
            # id 对不上, 但同一位置、同一标题的老项 → 也是同一项(reviewer 重编号了)
            same = next((x for x in items if loc(x) == loc(it) and x.get("title") == it.get("title") and it.get("file")), None)
            if same:
                cur, it["id"] = same, same["id"]
        if cur and loc(cur) == loc(it):
            # 同一项: 只更新文字, 状态 / 处理结果 / 提出轮次不动
            for k in ("title", "body", "suggestion", "priority", "snippet"):
                if it.get(k):
                    cur[k] = it[k]
            cur["round"] = cur.get("round", 1)
            updated += 1
            continue
        if cur:
            it["id"] = free_id(it["id"])
        used.add(it["id"])
        items.append(it)
        by_id[it["id"]] = it
        added += 1
    old["items"] = items
    old["author"] = new.get("author") or old.get("author")
    old["summary"] = new.get("summary") or old.get("summary", "")
    old["strengths"] = new.get("strengths") or old.get("strengths", [])
    old.setdefault("rounds", []).append(dict(round=rnd, author=new.get("author"), at=now_iso(), summary=new.get("summary", ""),
                                             strengths=new.get("strengths", []), added=added, updated=updated))
    old["_merge"] = dict(round=rnd, added=added, updated=updated, noted=noted, kept=len(items) - added)
    return old


def review_counts(rv):
    c = {"high": 0, "medium": 0, "low": 0, "open": 0, "done": 0, "wontfix": 0}
    for it in (rv or {}).get("items", []):
        if it.get("status", "open") == "open":
            c[it["priority"]] = c.get(it["priority"], 0) + 1
        c[it.get("status", "open")] = c.get(it.get("status", "open"), 0) + 1
    return c


def review_markdown(rv, diff):
    """按用户给的模板导出 markdown(贴到 PR / 交给别人)。"""
    out = [f"## 总体评价\n\n{rv.get('summary', '').strip()}\n", "## 优点\n"]
    out += [f"- {x}" for x in rv.get("strengths", [])] or ["- (无)"]
    out.append("\n## 待处理项\n")
    for pr in ("high", "medium", "low"):
        its = [it for it in rv.get("items", []) if it["priority"] == pr]
        if not its:
            continue
        out.append(f"### [{PRIO[pr]}]\n")
        for it in its:
            box = "x" if it.get("status") == "done" else ("~" if it.get("status") == "wontfix" else " ")
            loc = f"`{it['file']}`" + (f" L{it['line']}" if it.get("line") else "") if it.get("file") else ""
            out.append(f"- [{box}] **{it['title']}**  {loc}  `{it['id']}`")
            if it.get("snippet"):
                out.append(f"  ```\n  {it['snippet']}\n  ```")
            if it.get("body"):
                out.append("  " + it["body"].strip().replace("\n", "\n  "))
            if it.get("suggestion"):
                out.append("  **修改建议**: " + it["suggestion"].strip().replace("\n", "\n  "))
            if it.get("resolution"):
                out.append(f"  ✔ 处理结果({it.get('resolved_by', '')}): {it['resolution']}")
            for n in it.get("notes", []):
                out.append(f"  - {'✓' if n.get('verdict') == 'ok' else '⚠' if n.get('verdict') == 'disagree' else '·'} 复核({n.get('who', '')}, 第 {n.get('round', '?')} 轮): {n['body']}")
            out.append("")
    return "\n".join(out)


def list_sessions():
    out = []
    if not SESSIONS.is_dir():
        return out
    for p in sorted(SESSIONS.iterdir(), reverse=True):
        sj = read_json(p / "session.json", None)
        if not sj:
            continue
        cs = read_json(p / "comments.json", [])
        diff = read_json(p / "diff.json", {"files": []})
        notes = read_json(p / "notes.json", {})
        counts = {}
        for c in cs:
            counts[c["status"]] = counts.get(c["status"], 0) + 1
        out.append(dict(id=sj["id"], kind=sj["kind"], title=notes.get("title") or sj["title"], repo=sj["repo"],
                        created=sj["created"], meta=sj.get("meta", {}), archived=bool(sj.get("archived")),
                        files=len(diff["files"]), add=sum(f["add"] for f in diff["files"]),
                        del_=sum(f["del"] for f in diff["files"]), comments=len(cs), counts=counts,
                        noted=bool((notes.get("files") or {})), waiting=waiter_count(sj["id"]) > 0))
    return out


def q_force(handler):
    return "force=1" in urllib.parse.urlparse(handler.path).query


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "hudiff"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        if "/api/state" in (args[0] if args else "") or "/api/sessions" in (args[0] if args else ""):
            return
        sys.stderr.write("%s %s\n" % (dt.datetime.now().strftime("%H:%M:%S"), fmt % args))

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}") if n else {}

    def _route(self):
        """返回 (sid, d, rest) —— rest 是会话内路径(以 /api/… 或 / 开头); 非会话路径 sid=None。"""
        u = urllib.parse.urlparse(self.path)
        m = re.match(r"^/s/([0-9a-f\-]+)(/.*)?$", u.path)
        if m:
            sid = m.group(1); d = session_dir(sid)
            if not d.is_dir():
                return sid, None, m.group(2) or "/"
            return sid, d, (m.group(2) or "/")
        return None, None, u.path

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        sid, d, rest = self._route()
        if sid is None:
            if rest == "/":
                return self._send(200, page(INDEX_HTML).encode(), "text/html; charset=utf-8")
            if rest == "/api/sessions":
                return self._send(200, dict(sessions=list_sessions(), port=self.server.server_address[1]))
            if rest in ("/favicon.svg", "/favicon.ico"):
                return self._send(200, FAVICON_SVG.encode(), "image/svg+xml")
            return self._send(404, {"error": "not found"})
        if d is None:
            return self._send(404, f"<h3>会话 {sid} 不存在</h3><a href='/'>← 全部会话</a>".encode(), "text/html; charset=utf-8")
        if rest == "/":
            return self._send(200, page(HTML).encode(), "text/html; charset=utf-8")
        if rest == "/api/session":
            sess, diff, notes, comments = load(d)
            return self._send(200, dict(session=sess, diff=diff, notes=notes, comments=comments, state=sess_state(d),
                                        diagrams=diagram_list(sess, diff, notes), d2=bool(D2), review=load_review(d)))
        if rest == "/api/diagram":
            sess, diff, notes, _ = load(d)
            which = q.get("i", ["auto-map"])[0]
            theme = "dark" if q.get("theme", ["light"])[0] == "dark" else "light"
            svg = render_diagram(d, sess, diff, notes, which, theme)
            self.send_response(200)
            self.send_header("Content-Type", "image/svg+xml; charset=utf-8")
            self.send_header("Content-Length", str(len(svg)))
            self.send_header("Cache-Control", "max-age=31536000, immutable" if "v" in q else "no-store")   # URL 带版本号才允许长缓存
            self.end_headers()
            self.wfile.write(svg)
            return
        if rest == "/api/state":
            st = sess_state(d)
            st["waiting"] = waiter_count(sid)
            sess = read_json(d / "session.json", {})
            st["bound_alive"] = bound_alive(sess)
            return self._send(200, st)
        if rest == "/api/agents":
            sess = read_json(d / "session.json", {})
            return self._send(200, dict(agents=list_agents(sess, sid), waiting=waiter_count(sid), bound=sess.get("bound")))
        if rest == "/api/hang":            # 调试用: 拖住 load 事件, 让 headless 的 --dump-dom 等到探针跑完
            time.sleep(min(float(q.get("ms", ["1000"])[0]) / 1000, 30))
            return self._send(204, b"", "text/plain")
        if rest == "/api/wait":
            since = int(q.get("since", ["0"])[0])
            timeout = float(q.get("timeout", ["60"])[0])
            deadline = time.time() + timeout
            pane = q.get("pane", ["?"])[0] or "?"
            with Srv.cond:
                Srv.waiters.setdefault(sid, {})
                Srv.waiters[sid][pane] = Srv.waiters[sid].get(pane, 0) + 1
                try:
                    while read_json(d / "session.json", {}).get("submit_seq", 0) <= since:
                        left = deadline - time.time()
                        if left <= 0:
                            break
                        Srv.cond.wait(min(left, 5))
                finally:
                    Srv.waiters[sid][pane] -= 1
            seq = read_json(d / "session.json", {}).get("submit_seq", 0)
            return self._send(200, dict(submit_seq=seq, changed=seq > since))
        return self._send(404, {"error": "not found"})

    def do_POST(self):
        sid, d, rest = self._route()
        if d is None:
            return self._send(404, {"error": "no such session"})
        body = self._body()
        with Srv.lock:
            sess, diff, notes, comments = load(d)
            if rest == "/api/comments":
                c = dict(id=next_comment_id(comments), target=body.get("target", "line"),
                         file=body.get("file"), hunk=body.get("hunk"), side=body.get("side"),
                         line=body.get("line"), snippet=None, body=(body.get("body") or "").strip(),
                         status="open", stale=False, created=now_iso(), replies=[])
                if not c["body"]:
                    return self._send(400, {"error": "空评论"})
                if c["target"] == "line":
                    _, ln = find_line(diff, c["file"], c["hunk"], c["side"], c["line"])
                    if ln is None:
                        return self._send(400, {"error": "行不存在"})
                    c["snippet"] = ln["s"]
                comments.append(c)
                write_json(d / "comments.json", comments)
                return self._send(200, c)
            m = re.match(r"^/api/comments/([^/]+)/reply$", rest)
            if m:
                c = next((c for c in comments if c["id"] == m.group(1)), None)
                if not c:
                    return self._send(404, {"error": "no such comment"})
                who = body.get("who", "user")
                r = dict(who=who, body=(body.get("body") or "").strip(), ts=now_iso())
                if who == "user":
                    r["sent"] = False           # 每条用户回复自己记有没有发出去, 状态芯片跟着消息走而不是挂在根评论上
                c["replies"].append(r)
                c["status"] = "replied" if who == "agent" else "open"
                write_json(d / "comments.json", comments)
                return self._send(200, c)
            if rest == "/api/submit":
                # body: {pane?: 指定投递到哪个 Claude Code pane(顺便绑定), bind_only?: 只绑定不发}
                if body.get("pid") or body.get("pane"):
                    sess["bound"] = dict(pid=body.get("pid"), pane=body.get("pane"), label=body.get("label") or body.get("kind") or "agent", kind=body.get("kind"))
                if body.get("bind_only"):
                    write_json(d / "session.json", sess)
                    return self._send(200, dict(sent=0, bound=sess.get("bound")))
                n = 0
                for c in comments:
                    if c["status"] == "open":
                        c["status"] = "sent"; n += 1
                    for r in c.get("replies", []):
                        if r.get("who") == "user" and r.get("sent") is False:
                            r["sent"] = True
                write_json(d / "comments.json", comments)
                sess["submit_seq"] = sess.get("submit_seq", 0) + 1
                sess["last_submit"] = now_iso()
                write_json(d / "session.json", sess)
                with Srv.cond:
                    Srv.cond.notify_all()
                waiting = waiter_count(sid)
                delivered, err = ("wait" if waiting else None), None
                # 没人在 wait: 绑定的 agent 在 tmux 里就往它的 pane 打一句提示词; 不在 tmux 里只能标记, 等它自己来读
                b = sess.get("bound") or {}
                if not waiting and b:
                    if b.get("pane"):
                        ok, err = deliver_to_pane(b["pane"], f"hudiff 会话 {sid} 有 {n} 条新评论, 请处理: hudiff -s {sid} comments --new")
                        delivered = "pane" if ok else None
                    else:
                        err = "这个 agent 不在 tmux 里, 没有投递通道; 请在它的对话里说「处理 hudiff 评论」"
                return self._send(200, dict(sent=n, submit_seq=sess["submit_seq"], waiting=waiting, delivered=delivered,
                                            label=b.get("label"), error=err))
            if rest == "/api/notes":          # agent 侧也可以走这里写说明
                write_json(d / "notes.json", body)
                return self._send(200, {"ok": True})
            if rest == "/api/review":         # 审查报告写入(reviewer agent): 默认并进已有报告, ?replace=1 才覆盖
                problems, rv = validate_review(body, diff)
                if problems and not q_force(self):
                    return self._send(400, {"error": "校验失败", "problems": problems})
                replace = "replace=1" in urllib.parse.urlparse(self.path).query
                rv = merge_review(load_review(d), rv, replace=replace)
                rv["updated"] = now_iso()
                write_json(d / "review.json", rv)
                sess["submit_seq"] = sess.get("submit_seq", 0) + 1     # 叫醒在 wait 的 agent
                write_json(d / "session.json", sess)
                with Srv.cond:
                    Srv.cond.notify_all()
                return self._send(200, dict(ok=True, problems=problems, counts=review_counts(rv), merge=rv.get("_merge")))
            mn = re.match(r"^/api/review/([^/]+)/note$", rest)
            if mn:                                 # 给某个审查项追加一条复核 / 讨论说明
                rv = load_review(d) or {}
                it = next((x for x in rv.get("items", []) if x["id"] == mn.group(1)), None)
                if not it:
                    return self._send(404, {"error": "no such review item"})
                v = body.get("verdict") or "info"
                if v not in ("ok", "disagree", "info"):
                    return self._send(400, {"error": "verdict 只能是 ok / disagree / info"})
                it.setdefault("notes", []).append(dict(who=body.get("who") or "user", round=len(rv.get("rounds") or []) or 1,
                                                       body=(body.get("body") or "").strip(), verdict=v, ts=now_iso()))
                write_json(d / "review.json", rv)
                return self._send(200, it)
            if rest == "/api/review-request":  # 选一个 agent 去做交叉审查: 记下 reviewer, 能投递就把命令打进去
                sess["reviewer"] = dict(pid=body.get("pid"), pane=body.get("pane"), kind=body.get("kind"), label=body.get("label"), at=now_iso())
                write_json(d / "session.json", sess)
                delivered, err = False, None
                if body.get("pane"):
                    cmd = f"/hudiff review {sid}" if body.get("kind") == "claude" else f"请交叉审查 hudiff 会话 {sid}: 先跑 hudiff -s {sid} show 和 ctx 读改动, 按 hudiff 的审查报告 schema 写 JSON, 用 hudiff -s {sid} review set <文件> 写入"
                    delivered, err = deliver_to_pane(body["pane"], cmd)
                return self._send(200, dict(ok=True, delivered=delivered, error=err))
            if rest == "/api/notify":         # 只叫醒 wait, 不动评论
                sess["submit_seq"] = sess.get("submit_seq", 0) + 1
                write_json(d / "session.json", sess)
                with Srv.cond:
                    Srv.cond.notify_all()
                return self._send(200, dict(ok=True))
        return self._send(404, {"error": "not found"})

    def do_PATCH(self):
        sid, d, rest = self._route()
        if sid is None:                                  # PATCH /api/s/<id>  {archived: bool}
            m = re.match(r"^/api/s/([0-9a-f\-]+)$", rest)
            if m and session_dir(m.group(1)).is_dir():
                body = self._body()
                with Srv.lock:
                    sp = session_dir(m.group(1)) / "session.json"
                    sj = read_json(sp, {})
                    if "archived" in body:
                        sj["archived"] = now_iso() if body["archived"] else None
                    write_json(sp, sj)
                return self._send(200, dict(ok=True, archived=bool(sj.get("archived"))))
            return self._send(404, {"error": "not found"})
        mr = re.match(r"^/api/review/([^/]+)$", rest) if d else None
        if mr:
            body = self._body()
            with Srv.lock:
                rv = load_review(d)
                it = next((x for x in (rv or {}).get("items", []) if x["id"] == mr.group(1)), None)
                if not it:
                    return self._send(404, {"error": "no such review item"})
                st = body.get("status")
                if st not in ("open", "done", "wontfix"):
                    return self._send(400, {"error": "status 只能是 open / done / wontfix"})
                it["status"] = st
                if st == "open":
                    it.pop("resolution", None); it.pop("resolved_by", None); it.pop("resolved_at", None)
                else:
                    it["resolution"] = (body.get("resolution") or "").strip()
                    it["resolved_by"] = body.get("by", "user")
                    it["resolved_at"] = now_iso()
                write_json(d / "review.json", rv)
                return self._send(200, it)
        m = re.match(r"^/api/comments/([^/]+)$", rest) if d else None
        if not m:
            return self._send(404, {"error": "not found"})
        body = self._body()
        with Srv.lock:
            comments = read_json(d / "comments.json", [])
            c = next((c for c in comments if c["id"] == m.group(1)), None)
            if not c:
                return self._send(404, {"error": "no such comment"})
            for k in ("body", "status", "agent_done"):
                if k in body:
                    c[k] = body[k]
            if body.get("status") == "resolved":
                c["agent_done"] = False
            write_json(d / "comments.json", comments)
            return self._send(200, c)

    def do_DELETE(self):
        sid, d, rest = self._route()
        if sid is None:
            m = re.match(r"^/api/s/([0-9a-f\-]+)$", rest)
            if m and session_dir(m.group(1)).is_dir():
                with Srv.lock:
                    shutil.rmtree(session_dir(m.group(1)))
                return self._send(200, {"ok": True})
            return self._send(404, {"error": "not found"})
        m = re.match(r"^/api/comments/([^/]+)$", rest) if d else None
        if not m:
            return self._send(404, {"error": "not found"})
        with Srv.lock:
            comments = read_json(d / "comments.json", [])
            comments = [c for c in comments if c["id"] != m.group(1)]
            write_json(d / "comments.json", comments)
            return self._send(200, {"ok": True})


def cmd_serve(a):
    STATE.mkdir(parents=True, exist_ok=True)
    # 端口优先级: --port > 环境变量 HUDIFF_PORT > 上次用过的(重启后老标签页能续上) > 随机。写进 server.json。
    info = server_info()
    httpd = None
    tries = [x for x in (a.port, ENV_PORT, info.get("port")) if x] + [0]
    for port_try in tries:
        try:
            httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port_try), Handler)
            break
        except OSError:
            continue
    httpd.daemon_threads = True
    port = httpd.server_address[1]
    write_json(SERVER_JSON, dict(port=port, pid=os.getpid(), started=now_iso()))
    sys.stderr.write(f"hudiff serve http://127.0.0.1:{port}/\n")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


