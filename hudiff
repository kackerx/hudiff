.midbar .n{display:inline-block;min-width:16px;padding:0 5px;border-radius:8px;background:var(--bg3);color:var(--fg2);font-size:10.5px;line-height:16px;margin-left:4px} .midbar button.on .n{background:var(--accent);color:#fff}
.midbar .sp{flex:1} .midbar .hint{font-size:11px}
.diagrams{padding:14px 18px 40vh;background:var(--bg)}
.dg{border:1px solid var(--line);border-radius:12px;background:var(--bg);margin-bottom:18px;overflow:hidden;box-shadow:var(--shadow);border-left:3px solid var(--line)}
