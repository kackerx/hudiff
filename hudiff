    let snip=''; if(c.target==='line'){ const [,ln]=find(c); const t=ln?ln.t:(c.snippet!=null?' ':null); const txt=ln?ln.s:c.snippet; if(txt!=null) snip=`<div class="snip ${t==='+'?'add':t==='-'?'del':''}">${t===' '?' ':(t||' ')} ${esc(txt)}</div>`; }
