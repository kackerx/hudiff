.rv-head #rv-again{margin-left:6px;background:var(--bg3);border-color:var(--line);color:var(--fg);font-weight:500} .rv-head #rv-again:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.rv-sum .rnd{padding:4px 0} .rv-sum .rnd+.rnd{border-top:1px dashed var(--line);margin-top:6px;padding-top:8px} .rv-sum .rnd>div{margin-top:2px}
.rvo{border:1px solid var(--note-border);border-radius:8px;background:var(--note-bg);padding:6px 10px;margin-bottom:6px;cursor:pointer;display:flex;gap:8px;align-items:center;font-size:12.5px;border-left:3px solid var(--line)}
.rvo:hover{border-color:var(--accent)} .rvo.active{border-left-color:var(--accent)} .rvo.done,.rvo.wontfix{opacity:.55;text-decoration:line-through}
.rvo.high{border-left-color:var(--del-fg)} .rvo.medium{border-left-color:var(--warn)} .rvo.low{border-left-color:var(--accent)}
.rvo .t{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .rvo .l{font:10.5px var(--mono);color:var(--fg3);white-space:nowrap}
.rv-stats{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
tr.line.rv-high td.num:first-child{box-shadow:inset 3px 0 0 var(--del-fg)} tr.line.rv-medium td.num:first-child{box-shadow:inset 3px 0 0 var(--warn)} tr.line.rv-low td.num:first-child{box-shadow:inset 3px 0 0 var(--accent)}
