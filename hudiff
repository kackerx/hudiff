.rvi .note.ok{border-left-color:var(--ok);background:var(--ok-bg)} .rvi .note.ok .v{color:var(--ok)}
.rvi .note.disagree{border-left-color:#bc4c00;background:#fff1e5} .rvi .note.disagree .v{color:#bc4c00}
:root[data-theme="dark"] .rvi .note.disagree{background:#2a1a0c} @media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .rvi .note.disagree{background:#2a1a0c}}
@keyframes rvlocate{0%{box-shadow:0 0 0 3px var(--accent);background:var(--accent-soft)}70%{box-shadow:0 0 0 3px var(--accent);background:var(--accent-soft)}100%{box-shadow:var(--shadow);background:var(--bg)}} .rvi.locate{animation:rvlocate 1.6s ease-out}
