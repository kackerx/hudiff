td.num{text-align:right;padding:0 8px 0 0;color:var(--fg3);user-select:none;font-size:11px}
td.gut{text-align:center;user-select:none;position:relative}
td.gut{cursor:pointer} td.gut::after{content:"+";display:none;width:18px;height:18px;line-height:17px;border-radius:4px;font-size:14px;background:var(--accent);color:#fff;margin:1px auto 0;font-weight:700}
