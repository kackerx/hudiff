.hljs{background:transparent!important;color:inherit;padding:0!important}
.binhint{padding:10px 14px}

/* ── 评论线程 ── */
.thread{border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:10px 14px;max-width:860px;margin:4px 0;box-shadow:var(--shadow)}
.thread .meta{display:flex;gap:8px;align-items:center;font-size:11.5px;color:var(--fg2);margin-bottom:3px}
.thread .meta .av{width:20px;height:20px;border-radius:50%;background:var(--bg3);color:var(--fg);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}
.thread .meta .av.agent{background:var(--accent);color:#fff}
.thread .meta .who{font-weight:600;color:var(--fg)} .thread .meta .who.agent{color:var(--accent)}
.thread .msg{white-space:pre-wrap;word-break:break-word;padding-left:28px}
.thread .msg p{margin:0 0 4px} .thread .msg ul{margin:2px 0;padding-left:18px}
.thread .reply{margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)}
.thread .acts{margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;padding-left:28px}
.cform textarea{width:100%;max-width:860px;min-height:70px;font:13px/1.55 var(--sans);padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--fg);resize:vertical;outline:none}
.cform textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
.cform .acts{margin-top:6px;display:flex;gap:6px;align-items:center;color:var(--fg2);font-size:11.5px}
.thread .cform{margin-top:8px;padding-left:28px}

