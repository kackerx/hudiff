class Srv:
    lock = threading.Lock()
    cond = threading.Condition()
    waiters = {}          # sid -> {tmux pane 或 '?': 正在 long-poll 的数量}; 首页显示「agent 在等」, 发送按钮据此决定要不要弹选择


def waiter_count(sid):
    return sum(Srv.waiters.get(sid, {}).values())


def waiter_panes(sid):
    return [p for p, n in Srv.waiters.get(sid, {}).items() if n > 0 and p.startswith("%")]


def sess_state(d):
    def mt(p):
        try:
            return os.stat(p).st_mtime_ns
        except FileNotFoundError:
            return 0
    return dict(notes_v=mt(d / "notes.json"), comments_v=mt(d / "comments.json"), review_v=mt(d / "review.json"),
                diff_v=mt(d / "diff.json"), submit_seq=read_json(d / "session.json", {}).get("submit_seq", 0))


