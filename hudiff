.cbar .chip{cursor:pointer;border:1px solid transparent;user-select:none} .cbar .chip.off{opacity:.4;background:transparent;border-color:var(--line)}
.ccard{border:1px solid var(--note-border);border-radius:10px;background:var(--note-bg);margin-bottom:8px;cursor:pointer;box-shadow:var(--shadow);overflow:hidden;transition:border-color .12s}
.ccard:hover{border-color:var(--accent)} .ccard.resolved{opacity:.6}
.ccard .ch{display:flex;gap:6px;align-items:center;padding:6px 10px;background:var(--bg2);border-bottom:1px solid var(--line2);font-size:11.5px;color:var(--fg2)}
.ccard .ch .f{font-family:var(--mono);color:var(--fg);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1} .ccard .ch .f .d{color:var(--fg3)}
.ccard .ch .ln{font-family:var(--mono);white-space:nowrap}
.ccard .snip{font-family:var(--mono);font-size:11px;padding:3px 10px;white-space:pre;overflow:hidden;text-overflow:ellipsis;color:var(--fg2);border-bottom:1px solid var(--line2)}
.ccard .snip.add{background:var(--add-bg);color:var(--add-fg)} .ccard .snip.del{background:var(--del-bg);color:var(--del-fg)}
.ccard .cb{padding:7px 10px;font-size:12.5px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}
.ccard .cf{display:flex;gap:6px;align-items:center;padding:0 10px 7px;font-size:11px;color:var(--fg2)} .ccard .cf .last{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .ccard .cf .last b{color:var(--accent);font-weight:600}
