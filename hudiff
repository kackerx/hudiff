def cmd_show(a):
    sid, d = current_session(a.session)
    sess, diff, notes, _ = load(d)
    print(f"# hudiff 会话 {sid}: {sess['title']}  [{sess['kind']}]")
    print("# 每个 hunk 标着 [路径#序号], 写 notes.json 时用这个序号做 key。行号两列 = 旧版 | 新版。")
    print("# 序号后的标记: ✓ 已有说明  · 已标记为无需说明(null)  空 = 还没写")
    if a.func or a.unified:
        print("# 行首 ~ 的是补充上下文(新版文件里的原文, 不属于 diff), 只为看清所在函数/块。")
    b = sess.get("brief")
    if b:
        print("\n## 审查要求(用户给的, 写说明时照这个来)")
        for pr in b.get("presets", []):
            print(f"### 预设 {pr['path']}\n{pr['text']}")
        if b.get("prompt"):
            print(f"### 本次\n{b['prompt']}")
        if b.get("context"):
            print("### 上下文文件(先读)\n" + "\n".join("  " + c for c in b["context"]))
    for f in diff["files"]:
        if a.file and f["path"] != a.file and f.get("old_path") != a.file:
            continue
        ren = f" (原 {f['old_path']})" if f["status"] == "R" else ""
        print(f"\n=== {f['path']}{ren}  [{f['status']}]  +{f['add']} -{f['del']}" + ("  (binary)" if f["binary"] else ""))
        new_lines = None
        if a.func or a.unified:
            _, new_lines = file_versions(sess, f["path"], f.get("old_path"))
            if new_lines is None:
                print("    (取不到新版全文, 只能看 diff 自带的上下文)")
        w = max([len(str(ln["o"] or ln["n"])) for h in f["hunks"] for ln in h["lines"]] + [3])
        if new_lines is not None:
            w = max(w, len(str(len(new_lines))))
        for i, h in enumerate(f["hunks"]):
            hn = (notes.get("files", {}).get(f["path"], {}).get("hunks", {}) or {}).get(str(i), 0)
            has_note = " " if hn == 0 else ("·" if hn is None or (isinstance(hn, dict) and hn.get("skip")) else "✓")
            print(f"--- [{f['path']}#{i}] {has_note} {h['header']}")
            # 补充上下文: -W 整个顶层块 / -U N 前后各 N 行, 都来自【新版】文件, 用 ~ 标记以示不是 diff 的一部分
            pre, post = [], []
            if (a.func or a.unified) and new_lines and h["new_count"] > 0:
                hs, he = h["new_start"], h["new_start"] + h["new_count"] - 1
                if a.func:
                    ba, bb = enclosing_block(new_lines, hs, he)
                else:
                    ba, bb = max(1, hs - a.unified), min(len(new_lines), he + a.unified)
                pre = [(k, new_lines[k - 1]) for k in range(ba, hs)]
                post = [(k, new_lines[k - 1]) for k in range(he + 1, bb + 1)]
            for k, t in pre:
                print(f"{'':>{w}} {k:>{w}} ~{t}")
            for ln in h["lines"]:
                o = str(ln["o"]) if ln["o"] else ""
                n = str(ln["n"]) if ln["n"] else ""
                print(f"{o:>{w}} {n:>{w}} {ln['t']}{ln['s']}")
            for k, t in post:
                print(f"{'':>{w}} {k:>{w}} ~{t}")


# 从 +/- 行里认出「定义了什么」: 语言族 → 正则列表, 每个正则第一个捕获组是符号名
# 只认【定义】, 不认局部变量赋值 —— 局部名(name/set/paths)一 grep 就是几千处噪音。
SYM_RES = {
    "go":     [r"^func\s+(?:\([^)]*\)\s*)?(\w+)", r"^type\s+(\w+)", r"^(?:var|const)\s+(\w+)"],
    "py":     [r"^\s*(?:async\s+)?def\s+(\w+)", r"^\s*class\s+(\w+)", r"^([A-Z_][A-Z0-9_]{2,})\s*="],
    "jsts":   [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*(\w+)", r"^(?:export\s+)?(?:default\s+)?class\s+(\w+)",
               r"^export\s+(?:const|let|var)\s+(\w+)", r"^(?:export\s+)?(?:interface|type|enum)\s+(\w+)", r"^\s+(?:async\s+)?(\w+)\s*\([^)]*\)\s*\{"],
    "lua":    [r"^(?:local\s+)?function\s+([\w.:]+)", r"^(\w+(?:\.\w+)+)\s*=\s*function", r"^M\.(\w+)\s*="],
    "rs":     [r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+(\w+)", r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:struct|enum|trait|type)\s+(\w+)"],
    "sh":     [r"^\s*(?:function\s+)?([A-Za-z_]\w*)\s*\(\)\s*\{", r"^([A-Z_][A-Z0-9_]{2,})="],
    "java":   [r"^\s*(?:public|private|protected|static|\s)*[\w<>\[\],\s]+\s+(\w+)\s*\([^)]*\)\s*(?:throws[^{]*)?\{", r"^\s*(?:public\s+)?(?:class|interface|enum|record)\s+(\w+)"],
}
NOISE_CAP = 120   # 引用超过这个数的符号名太泛(比如 init/run), 不逐条列
LANG_FAMILY = {"go": "go", "py": "py", "js": "jsts", "mjs": "jsts", "ts": "jsts", "tsx": "jsts", "jsx": "jsts", "vue": "jsts",
               "lua": "lua", "rs": "rs", "sh": "sh", "bash": "sh", "zsh": "sh", "java": "java", "kt": "java", "swift": "java", "c": "java", "cpp": "java", "h": "java"}
TEST_PAT = re.compile(r"(_test\.go|test_.*\.py|_test\.py|\.test\.[jt]sx?|\.spec\.[jt]sx?|_spec\.rb|Test\w*\.(java|kt)|_test\.lua|/tests?/)$|/tests?/")


def sym_family(path):
    base = path.split("/")[-1]
    ext = base.rsplit(".", 1)[-1].lower() if "." in base else ""
    if not ext and base and not base.startswith("."):
        return "sh"          # 无扩展名多半是脚本
    return LANG_FAMILY.get(ext)


def collect_ctx(sess, diff, only=None, refs_cap=6):
    """每个改动文件: 近史 / 改了哪些符号(+ - ~) / 改动文件之外的引用 / 相关测试。cmd_ctx 打印它, 自动图画它。"""
    repo = sess["repo"]

    def g(*args):
        p = subprocess.run(["git", "-C", repo, *args], text=True, capture_output=True, errors="replace")
        return p.stdout if p.returncode == 0 else ""

    changed_paths = {f["path"] for f in diff["files"]}
    ls_files = None
    out = []
    for f in diff["files"]:
        path = f["path"]
        if only and path != only:
            continue
        item = dict(path=path, status=f["status"], add=f["add"], del_=f["del"], hist=[], fam=None, syms=[], tests=set())
        item["hist"] = g("log", "-n", "4", "--format=%h %ad %an  %s", "--date=short", "--", path).rstrip().splitlines()
        fam = item["fam"] = sym_family(path)
        added, removed = {}, {}
        for hi, h in enumerate(f["hunks"]):
            for ln in h["lines"]:
                if ln["t"] == " " or not fam:
                    continue
                for rx in SYM_RES[fam]:
                    m = re.match(rx, ln["s"])
                    if m and m.group(1) and len(m.group(1)) > 1 and not m.group(1)[0].isdigit():
                        (added if ln["t"] == "+" else removed).setdefault(m.group(1), hi)
                        break
        both = set(added) & set(removed)
        order = [(k, "~", added[k]) for k in added if k in both] + [(k, "+", added[k]) for k in added if k not in both] + [(k, "-", removed[k]) for k in removed if k not in both]
        for name, kind, hi in order[:20]:
            needle = name.split(".")[-1].split(":")[-1]
            hits = [l for l in g("grep", "-n", "-w", "-I", "--", needle, ".").splitlines() if not l.startswith(path + ":")]
            sym = dict(name=name, kind=kind, hunk=hi, total=len(hits), noisy=len(hits) > NOISE_CAP, refs=[], in_changed=0, in_tests=0)
            if not sym["noisy"]:
                for l in hits:
                    fn, rest = l.split(":", 1)
                    lno, txt = (rest.split(":", 1) + [""])[:2]
                    if fn in changed_paths:
                        sym["in_changed"] += 1
                    if TEST_PAT.search(fn):
                        sym["in_tests"] += 1
                    if len(sym["refs"]) < refs_cap:
                        sym["refs"].append((fn, lno, txt.strip()[:110]))
                sym["ref_files"] = sorted({l.split(":", 1)[0] for l in hits})
            item["syms"].append(sym)
        # 相关测试
        if ls_files is None:
            ls_files = g("ls-files").splitlines()
        stem = path.split("/")[-1].rsplit(".", 1)[0]
        for l in ls_files:
            if TEST_PAT.search(l) and l != path and stem in l.split("/")[-1]:
                item["tests"].add(l)
        for sym in item["syms"][:10]:
            if sym["noisy"]:
                continue
            for fn in sym.get("ref_files", []):
                if TEST_PAT.search(fn) and fn != path:
                    item["tests"].add(fn)
        item["tests"] = sorted(item["tests"])
        out.append(item)
    return out


def cmd_ctx(a):
    sid, d = current_session(a.session)
    sess, diff, notes, _ = load(d)
    repo = sess["repo"]
    if subprocess.run(["git", "-C", repo, "rev-parse"], capture_output=True).returncode != 0:
        die("会话对应的仓库不在了, 没法查上下文")
    changed_paths = {f["path"] for f in diff["files"]}
    print(f"# hudiff 会话 {sid}: 仓库级上下文  ({repo})")
    print("# 用法: 写说明前先看这份 —— 「谁在调用」决定影响面, 「近史」常常就是这次改动的动机, 「测试」告诉你有没有验证。")
    for item in collect_ctx(sess, diff, only=a.file, refs_cap=a.refs):
        path = item["path"]
        print(f"\n=== {path}  [{item['status']}]  +{item['add']} -{item['del_']}")
        if item["hist"]:
            print("近史:")
            for h in item["hist"]:
                print("  " + h)
        if item["fam"] and item["syms"]:
            print("符号: " + "  ".join(f"{s['kind'] if s['kind'] != '+' else '+'}{s['name']}(#{s['hunk']})" for s in item["syms"]))
        elif not item["fam"]:
            print("符号: (这种文件类型没有符号规则, 跳过)")
        if item["syms"]:
            print("引用(改动文件之外):")
            for sym in item["syms"]:
                if sym["noisy"]:
                    print(f"  {sym['name']}: {sym['total']} 处, 名字太泛, 不列(要看就 git grep -nw {sym['name'].split('.')[-1]})")
                    continue
                if not sym["total"]:
                    tag = "  (已删除, 别处也没引用, 干净)" if sym["kind"] == "-" else ("  (新符号, 还没人用)" if sym["kind"] == "+" else "  (仓库里没有别处引用)")
                    print(f"  {sym['name']}: 0{tag}")
                    continue
                extra = []
                if sym["in_changed"]:
                    extra.append(f"其中 {sym['in_changed']} 处在本次改动的其它文件里")
                if sym["in_tests"]:
                    extra.append(f"{sym['in_tests']} 处在测试里")
                if sym["kind"] == "-":
                    extra.append("⚠ 符号被删了但别处还在引用")
                print(f"  {sym['name']}: {sym['total']} 处" + ("  (" + "; ".join(extra) + ")" if extra else ""))
                for fn, lno, txt in sym["refs"]:
                    print(f"      {fn}:{lno}  {txt}")
                if sym["total"] > len(sym["refs"]):
                    print(f"      … 还有 {sym['total'] - len(sym['refs'])} 处")
        if item["tests"]:
            in_diff = [c for c in item["tests"] if c in changed_paths]
            print("相关测试: " + ", ".join(item["tests"][:8]) + (" …" if len(item["tests"]) > 8 else "") + (f"   (本次改了其中 {len(in_diff)} 个)" if in_diff else "   (本次没动任何测试)"))
        elif not TEST_PAT.search(path) and item["status"] != "D":
            print("相关测试: 没找到  ⚠ 这个文件的改动没有测试覆盖(或测试不按常规命名)")


# ─── 图解: d2 渲染(带缓存) + 自动生成的「改动地图」 ─────────────────────────

D2 = shutil.which("d2")
D2_THEME = {"light": "0", "dark": "200"}
MULTIBOARD_RE = re.compile(r"^\s*(steps|layers|scenarios)\s*:", re.M)


def d2_render(src, theme="light"):
    """返回 (svg_bytes, err)。多板(steps/layers)不能写 stdout, 走临时文件并做成逐帧动画。"""
    if not D2:
        return None, "d2 未安装: brew install d2"
    # --scale 1: 让 svg 带上明确的 width/height。默认的 -1 只给 viewBox, 放进 <img> 里在某些布局下会算成 0 高。
    args = [D2, "--theme", D2_THEME.get(theme, "0"), "--pad", "16", "--layout", "dagre", "--scale", "1"]
    try:
        if MULTIBOARD_RE.search(src):
            with tempfile.TemporaryDirectory() as td:
                out = os.path.join(td, "out.svg")
                p = subprocess.run(args + ["--animate-interval", "1400", "-", out], input=src, text=True, capture_output=True, timeout=30)
                if p.returncode != 0:
                    return None, p.stderr.strip()
                return Path(out).read_bytes(), None
        p = subprocess.run(args + ["-", "-"], input=src.encode(), capture_output=True, timeout=30)
        if p.returncode != 0:
            return None, p.stderr.decode(errors="replace").strip()
        return p.stdout, None
    except subprocess.TimeoutExpired:
        return None, "d2 渲染超时(30s)"


def d2_check(src):
    """只编译不要结果, 给 notes 校验用。"""
    _, err = d2_render(src, "light")
    return err


def error_svg(msg):
    msg = msg.replace("&", "&amp;").replace("<", "&lt;")
    lines = [msg[i:i + 90] for i in range(0, min(len(msg), 900), 90)]
    body = "".join(f'<text x="16" y="{40 + i * 18}" font-family="monospace" font-size="12" fill="#cf222e">{l}</text>' for i, l in enumerate(lines))
    return f'<svg xmlns="http://www.w3.org/2000/svg" width="860" height="{60 + 18 * len(lines)}"><rect width="100%" height="100%" fill="#fff5f5" stroke="#f0a0a0"/><text x="16" y="22" font-family="sans-serif" font-size="13" fill="#82071e">图渲染失败</text>{body}</svg>'.encode()


def d2q(s):
    """d2 的 key/label 引号转义。"""
    return '"' + str(s).replace('"', '\\"') + '"'   # 不转义反斜杠: 标签里要留 \n 给 d2 当换行


def auto_map_src(sess, diff):
    """改动地图: 文件 → 本次改动的符号 → 改动文件之外的引用方。全自动, 不用 agent 写。"""
    items = collect_ctx(sess, diff, refs_cap=4)
    L = ["direction: right",
         "classes: {",
         "  file: { style: { fill: \"#f6f8fa\"; stroke: \"#8b949e\"; border-radius: 8; font-size: 14 } }",
         "  added: { style: { fill: \"#dafbe1\"; stroke: \"#1a7f37\"; font-size: 13; border-radius: 4 } }",
         "  removed: { style: { fill: \"#ffebe9\"; stroke: \"#cf222e\"; font-size: 13; border-radius: 4; stroke-dash: 3 } }",
         "  changed: { style: { fill: \"#fff8c5\"; stroke: \"#9a6700\"; font-size: 13; border-radius: 4 } }",
         "  ext: { style: { fill: \"#ffffff\"; stroke: \"#d0d7de\"; font-size: 12; border-radius: 6; stroke-dash: 2 } }",
         "  danger: { style: { stroke: \"#cf222e\"; stroke-width: 2; font-color: \"#cf222e\" } }",
         "  ref: { style: { stroke: \"#8b949e\"; font-size: 11 } }",
         "}"]
    st = {"A": "新增", "D": "删除", "R": "重命名", "M": "修改"}
    ext_nodes = {}
    edges = []
    plain = []
    for it in items:
        fid = d2q(it["path"])
        label = f"{it['path'].split('/')[-1]}\\n{st.get(it['status'], it['status'])}  +{it['add']} -{it['del_']}"
        if not it["syms"]:
            plain.append((fid, label, it["path"]))
            continue
        L.append(f"{fid}: {{")
        L.append(f"  label: {d2q(label)}")
        L.append("  class: file")
        L.append(f"  tooltip: {d2q(it['path'])}")
        for sym in it["syms"][:12]:
            cls = {"+": "added", "-": "removed", "~": "changed"}[sym["kind"]]
            lab = f"{sym['kind']} {sym['name']}" + (f"  ·{sym['total']} 处引用" if sym["total"] and sym["noisy"] else "")
            L.append(f"  {d2q(sym['name'])}: {{ label: {d2q(lab)}; class: {cls} }}")
        L.append("}")
        for sym in it["syms"][:12]:
            if sym["noisy"] or not sym["total"]:
                continue
            files = [f for f in sym.get("ref_files", []) if f != it["path"]]
            shown = files[:4]
            for f in shown:
                if f not in {x["path"] for x in items}:
                    ext_nodes[f] = ext_nodes.get(f, 0) + 1
                danger = sym["kind"] == "-"
                lab = "仍在引用!" if danger else ""
                edges.append(f"{fid}.{d2q(sym['name'])} -> {d2q(f)}" + (f": {d2q(lab)}" if lab else "") + " { class: " + ("danger" if danger else "ref") + " }")
            if len(files) > 4:
                more = f"…另 {len(files) - 4} 个文件引用 {sym['name']}"
                mid = d2q(f"more:{it['path']}:{sym['name']}")
                L.append(f"{mid}: {{ label: {d2q(more)}; class: ext }}")
                edges.append(f"{fid}.{d2q(sym['name'])} -> {mid} {{ class: ref }}")
    for f in ext_nodes:
        L.append(f"{d2q(f)}: {{ label: {d2q(f.split('/')[-1])}; class: ext; tooltip: {d2q(f)} }}")
    if plain:
        if len(plain) <= 8:
            for fid, label, full in plain:
                L.append(f"{fid}: {{ label: {d2q(label)}; class: file; tooltip: {d2q(full)} }}")
        else:
            L.append(f"others: {{ label: {d2q(f'其它 {len(plain)} 个文件(无符号级改动)')}; class: file }}")
    L.extend(edges)
    return "\n".join(L) + "\n"


AUTO_SRC_CACHE = {}     # 会话 id -> (diff.json mtime, d2 源码)


def tmux(*args):
    p = subprocess.run(["tmux", *args], text=True, capture_output=True)
    return p.returncode == 0, p.stdout.strip()


def pane_alive(pane):
    ok, out = tmux("display-message", "-pt", pane, "#{pane_id}")
    return ok and out == pane


def custom_title(log_path, tail_bytes=64 * 1024):
    """Claude Code 的 /rename 名字: transcript JSONL 里的 customTitle, 最后一次出现的才是当前的, 只读尾部。"""
    if not log_path:
        return None
    try:
        with open(log_path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - tail_bytes))
            chunk = fh.read().decode("utf-8", errors="replace")
    except OSError:
        return None
    title = None
    for line in chunk.splitlines():
        if '"customTitle"' in line:
            try:
                title = json.loads(line).get("customTitle") or title
            except json.JSONDecodeError:
                m = re.search(r'"customTitle"\s*:\s*"([^"]*)"', line)
                if m:
                    title = m.group(1)
    return title


AGENT_BINS = {"claude": "claude", "pi": "pi", "opencode": "opencode", "codex": "codex", "gemini": "gemini", "aider": "aider",
              "cursor-agent": "cursor", "crush": "crush", "amp": "amp", "goose": "goose", "kiro": "kiro", "copilot": "copilot"}


def parse_etime(s):
    """ps 的 etime: [[dd-]hh:]mm:ss → 秒。"""
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d)
    parts = [int(x) for x in s.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return days * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


PS_AGE = {}   # pid -> 已运行秒数(最近一次 ps_table 的结果), 给「目录:序号」排序用


def ps_table():
    """{pid: (ppid, comm)}; 顺手记下每个进程跑了多久。pid 在 macOS 上不是单调递增的(会回绕、会复用),
    所以「谁先开的」要看运行时长, 不能看 pid 大小。"""
    p = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,comm="], text=True, capture_output=True)
    out = {}
    for line in p.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit():
            out[int(parts[0])] = (int(parts[1]), parts[3])
            try:
                PS_AGE[int(parts[0])] = parse_etime(parts[2])
            except ValueError:
                pass
    return out


def ancestors(pid, table):
    seen = []
    while pid and pid in table and len(seen) < 40:
        seen.append(pid)
        pid = table[pid][0]
    return seen


def discover_agents():
    """本机在跑的 coding agent 进程: 名字 / pid / cwd / 分支 / (可选) tmux pane。
    不依赖任何特定工具: ps 找进程, lsof 拿 cwd, git 拿分支; 装了 ccmux-agents 的话用它补 Claude Code 的会话名。"""
    table = ps_table()
    agents = {}
    for pid, (ppid, comm) in table.items():
        base = os.path.basename(comm).lower()
        kind = AGENT_BINS.get(base)
        if not kind:
            continue
        # 同一个 agent 的子进程(比如 claude 起的 claude)只留最上层那个
        if any(table.get(x, (0, ""))[1] and os.path.basename(table[x][1]).lower() == base for x in ancestors(ppid, table)):
            continue
        agents[pid] = dict(pid=pid, kind=kind, label=kind, cwd="", branch="", pane=None)
    if not agents:
        return []
    p = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", ",".join(map(str, agents)), "-Fpn"], text=True, capture_output=True)
    cur = None
    for line in p.stdout.splitlines():
        if line.startswith("p"):
            cur = int(line[1:])
        elif line.startswith("n") and cur in agents:
            agents[cur]["cwd"] = line[1:]
    # tmux(可选): pane_pid 是 pane 里 shell 的 pid, agent 是它的后代
    ok, out = tmux("list-panes", "-a", "-F", "#{pane_id} #{pane_pid} #{window_index}.#{pane_index}")
    pos_of_pane = {}
    if ok:
        pane_of_pid = {}
        for l in out.splitlines():
            parts = l.split()
            if len(parts) == 3:
                pane_of_pid[int(parts[1])] = parts[0]
                pos_of_pane[parts[0]] = parts[2]          # "窗口.pane", 和 ccmux 的显示一致
        for ag in agents.values():
            for x in ancestors(ag["pid"], table):
                if x in pane_of_pid:
                    ag["pane"] = pane_of_pid[x]; break
    for ag in agents.values():
        ag["pos"] = pos_of_pane.get(ag["pane"]) if ag.get("pane") else None
    # 用户给 agent 起的名字(Claude Code 的 /rename): 名字写在 transcript 尾部的 customTitle 里。
    # pid → transcript 的对应关系目前只有 ccmux 知道(它靠 hook 记的), 装了就借它的 logPath; 没装就没有名字。
    for ag in agents.values():
        ag["name"] = None
    exe = shutil.which("ccmux-agents") or shutil.which("ccmux")
    if exe:
        try:
            cmd = [exe] if exe.endswith("ccmux-agents") else [exe, "show", "--json"]
            rows = json.loads(subprocess.run(cmd, text=True, capture_output=True, timeout=10).stdout)
            by_pane = {r.get("tmuxPane"): r for r in rows if isinstance(r, dict) and r.get("tmuxPane")}
            by_pid = {r.get("pid"): r for r in rows if isinstance(r, dict) and r.get("pid")}
            for ag in agents.values():
                r = by_pid.get(ag["pid"]) or by_pane.get(ag["pane"])
                if r:
                    ag["name"] = custom_title(r.get("logPath"))
                    if r.get("gitBranch"):
                        ag["branch"] = r["gitBranch"]
        except (json.JSONDecodeError, subprocess.TimeoutExpired, OSError):
            pass
    # 显示名: 有名字用名字; 没有就 目录名; 同目录同类 agent 多于一个时消歧: 在 tmux 里用 目录:窗口.pane
    # (和 ccmux 一样, 看到就知道去哪个窗口), 不在 tmux 里按启动先后编 目录:1 / 目录:2
    groups = {}
    for ag in agents.values():
        groups.setdefault((ag["kind"], ag["cwd"]), []).append(ag)
    for (kind, cwd), group in groups.items():
        group.sort(key=lambda a: (-PS_AGE.get(a["pid"], 0), a["pid"]))     # 先开的在前: 运行时间长的排前面
        base = os.path.basename(cwd.rstrip("/")) or cwd or kind
        if cwd == os.path.expanduser("~"):
            base = "~"
        for i, ag in enumerate(group, 1):
            if ag["name"]:
                ag["label"] = ag["name"]
            elif len(group) > 1:
                ag["label"] = f"{base}:{ag['pos']}" if ag.get("pos") else f"{base}:{i}"
            else:
                ag["label"] = base
    branch_cache = {}
    for ag in agents.values():
        if not ag["branch"] and ag["cwd"]:
            if ag["cwd"] not in branch_cache:
                p = subprocess.run(["git", "-C", ag["cwd"], "rev-parse", "--abbrev-ref", "HEAD"], text=True, capture_output=True)
                branch_cache[ag["cwd"]] = p.stdout.strip() if p.returncode == 0 else ""
            ag["branch"] = branch_cache[ag["cwd"]]
    return sorted(agents.values(), key=lambda a: (a["kind"], a["cwd"]))


def list_agents(sess, sid):
    repo = os.path.realpath(sess["repo"])
    waiting_pids = set()
    table = None
    for wp in waiter_pids(sid):
        table = table or ps_table()
        waiting_pids.update(ancestors(wp, table))
    waiting_panes = set(waiter_panes(sid))
    bound = sess.get("bound")            # {"pid":..,"pane":..,"label":..}
    home = os.path.expanduser("~")
    out = []
    for ag in discover_agents():
        cwd = os.path.realpath(ag["cwd"]) if ag["cwd"] else ""
        same = bool(cwd) and (cwd == repo or cwd.startswith(repo + os.sep) or repo.startswith(cwd + os.sep))
        cwd_s = "~" + ag["cwd"][len(home):] if ag["cwd"].startswith(home) else ag["cwd"]
        is_waiting = ag["pid"] in waiting_pids or (ag["pane"] and ag["pane"] in waiting_panes)
        out.append(dict(pid=ag["pid"], pane=ag["pane"], kind=ag["kind"], label=ag["label"], cwd=ag["cwd"], cwd_short=cwd_s,
                        branch=ag["branch"], same_repo=same, waiting=bool(is_waiting),
                        bound=bool(bound) and (bound.get("pid") == ag["pid"] or (bound.get("pane") and bound.get("pane") == ag["pane"])),
                        deliverable=bool(ag["pane"])))
    out.sort(key=lambda a: (not a["waiting"], not a["bound"], not a["same_repo"], a["kind"], a["label"]))
    return out


def waiter_pids(sid):
    return [int(p[4:]) for p in Srv.waiters.get(sid, {}) if p.startswith("pid:") and Srv.waiters[sid][p] > 0]


def bound_alive(sess):
    b = sess.get("bound")
    if not b:
        return False
    if b.get("pid"):
        try:
            os.kill(int(b["pid"]), 0)
        except OSError:
            return False
        return True
    return bool(b.get("pane") and pane_alive(b["pane"]))


def deliver_to_pane(pane, text):
    """把一句提示词打进那个 Claude Code pane(它支持运行中排队输入)。-l 按字面发送, 再单独发回车。"""
    if not pane_alive(pane):
        return False, "pane 不在了"
    ok, err = tmux("send-keys", "-t", pane, "-l", text)
    if not ok:
        return False, err
    time.sleep(0.15)
    tmux("send-keys", "-t", pane, "Enter")
    return True, None


def diagram_list(sess, diff, notes):
    """页面用的图清单: 自动图 + agent 写的。"""
    out = []
    if D2 and any(f["hunks"] for f in diff["files"]):
        out.append(dict(id="auto-map", title="改动地图(自动)", kind="d2", auto=True, hunks=[],
                        caption="文件 → 本次新增(绿)/删除(红)/改动(黄)的符号 → 改动文件之外的引用方。红线 = 符号被删了但别处还在引用。由 `hudiff ctx` 的数据自动生成, 不是 agent 画的。"))
    for i, dg in enumerate(notes.get("diagrams") or []):
        if isinstance(dg, dict):
            out.append(dict(id=dg.get("id") or f"d{i}", title=dg.get("title") or f"图 {i + 1}", kind=dg.get("kind", "d2"), auto=False,
                            hunks=dg.get("hunks") or [], caption=dg.get("caption") or "", src=dg.get("src", ""), index=i))
    return out


def render_diagram(d, sess, diff, notes, which, theme):
    """which = 'auto-map' 或 diagrams 数组下标/id。带哈希缓存: 源码或主题变了才重画。"""
    if which == "auto-map":
        dv = os.stat(d / "diff.json").st_mtime_ns
        hit = AUTO_SRC_CACHE.get(d.name)
        if hit and hit[0] == dv:
            src = hit[1]
        else:
            src = auto_map_src(sess, diff)
            AUTO_SRC_CACHE[d.name] = (dv, src)
    else:
        dgs = notes.get("diagrams") or []
        dg = None
        if which.isdigit() and int(which) < len(dgs):
            dg = dgs[int(which)]
        else:
            dg = next((x for x in dgs if isinstance(x, dict) and x.get("id") == which), None)
        if not dg:
            return error_svg(f"没有这张图: {which}")
        if dg.get("kind", "d2") != "d2":
            return error_svg("这张图不是 d2, 由浏览器渲染")
        src = dg.get("src", "")
    key = hashlib.sha1(f"{theme}\x00{src}".encode()).hexdigest()[:16]
    cache = d / "diagrams" / f"{key}.svg"
    if cache.exists():
        return cache.read_bytes()
    svg, err = d2_render(src, theme)
    if err:
        return error_svg(err)
    cache.parent.mkdir(exist_ok=True)
    cache.write_bytes(svg)
    return svg


def cmd_diagram(a):
    """命令行看/导出: hudiff diagram [auto-map|<id>] [--src] [-o out.svg]"""
    sid, d = current_session(a.session)
