      <div class="cf"><span class="last">${last?`<b>${last.who==='agent'?'agent':'我'}:</b> ${esc(last.body.split('\n')[0])}`:'没有回复'}</span><span>${(c.replies||[]).length?(c.replies.length+' 条回复'):''}</span><span class="hint">${c.id}</span></div></div>`;
