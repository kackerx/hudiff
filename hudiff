tr.line:hover td.code{box-shadow:inset 0 0 0 100vw rgba(0,0,0,.035)} :root[data-theme="dark"] tr.line:hover td.code{box-shadow:inset 0 0 0 100vw rgba(255,255,255,.05)}
td.code{white-space:pre-wrap;word-break:break-all;padding-right:14px}
