def file_versions(sess, path, old_path=None):
    """返回 (旧版全文行列表, 新版全文行列表), 取不到的为 None。按会话类型决定去哪拿。"""
    repo, kind, m = sess["repo"], sess["kind"], sess.get("meta", {})

    def git_show(rev, pth):
        if not rev or not pth:
            return None
        p = subprocess.run(["git", "-C", repo, "show", f"{rev}:{pth}"], text=True, capture_output=True, errors="replace")
        return p.stdout.splitlines() if p.returncode == 0 else None

    def disk(pth):
        try:
            return Path(repo, pth).read_text(errors="replace").splitlines()
        except (FileNotFoundError, IsADirectoryError):
            return None

    op = old_path or path
    if kind == "worktree":
        new = git_show("", path) if m.get("scope") == "staged" else disk(path)   # 已暂存 → 索引里的版本 (":path")
        if m.get("scope") == "staged":
            new = git_show("", path) or new
        return git_show("HEAD", op), new
    if kind == "commit":
        return git_show(m.get("base"), op), git_show(m.get("full"), path)
    if kind == "range":
        return git_show(m.get("base"), op), git_show(m.get("head"), path)
    if kind == "pr":
        head = m.get("head")
        for rev in (f"origin/{head}", head):
            new = git_show(rev, path)
            if new is not None:
                return git_show(f"origin/{m.get('base')}", op) or git_show(m.get("base"), op), new
        return None, None
    return None, None


FUNC_RE = re.compile(r"^[A-Za-z_$@#]")      # git 默认的 funcname 规则: 顶格非空白开头的行 = 一个顶层块的起点


def enclosing_block(lines, start, end, cap=160):
    """[start, end] 是新版 1-based 行号区间, 往上找顶层块起点、往下找下一个顶层块起点, 返回 (a, b) 1-based。
    超过 cap 行就退化成 hunk 上下各 30 行, 免得把整个文件倒出来。"""
    n = len(lines)
    a = max(1, min(start, n))
    while a > 1 and not FUNC_RE.match(lines[a - 1]):
        a -= 1
    b = max(end, a)
    while b < n and not FUNC_RE.match(lines[b]):       # lines[b] 是第 b+1 行
        b += 1
    while b > end and b <= n and not lines[b - 1].strip():
        b -= 1
    if b - a + 1 > cap:
        a, b = max(1, start - 30), min(n, end + 30)
    return a, b


