def cmd_notes(a):
    sid, d = current_session(a.session)
    text = sys.stdin.read() if a.path == "-" else Path(a.path).read_text()
    try:
        notes = json.loads(text)
    except json.JSONDecodeError as e:
        die(f"notes 不是合法 JSON: {e}")
    diff = read_json(d / "diff.json", {"files": []})
    by_path = {f["path"]: f for f in diff["files"]}
    problems, covered, skipped = [], 0, 0
    files = notes.get("files") or {}
    if isinstance(files, list):
        die("notes.files 应是 {路径: {...}} 的对象, 不是数组")
    for path, fn in files.items():
        if path not in by_path:
            problems.append(f"文件不在 diff 里: {path}")
            continue
        hunks = fn.get("hunks") or {}
        if isinstance(hunks, list):          # 顺手接受数组形式, 转成 {"0":..}
            hunks = {str(i): h for i, h in enumerate(hunks)}
            fn["hunks"] = hunks
        for k, hn in hunks.items():
            if not k.isdigit() or int(k) >= len(by_path[path]["hunks"]):
                problems.append(f"{path}#{k}: 没有这个 hunk(共 {len(by_path[path]['hunks'])} 个)")
                continue
            if hn is None or (isinstance(hn, dict) and hn.get("skip")):
                skipped += 1
                continue
            if not isinstance(hn, dict) or not (hn.get("body") or hn.get("title")):
                problems.append(f"{path}#{k}: 空说明(无需说明的 hunk 写 null)")
            covered += 1
    # 图解校验: 结构 + hunk 锚点 + d2 能编译
    dgs = notes.get("diagrams")
    if dgs is not None and not isinstance(dgs, list):
        problems.append("notes.diagrams 应是数组")
        dgs = []
    ids = set()
    for i, dg in enumerate(dgs or []):
        tag = f"diagrams[{i}]"
        if not isinstance(dg, dict):
            problems.append(f"{tag}: 不是对象"); continue
        if not dg.get("src", "").strip():
            problems.append(f"{tag}: 缺 src")
        if not dg.get("title"):
            problems.append(f"{tag}: 缺 title")
        if dg.get("kind", "d2") not in ("d2", "mermaid"):
            problems.append(f"{tag}: kind 只能是 d2 / mermaid")
        did = dg.get("id") or f"d{i}"
        if did in ids or did == "auto-map":
            problems.append(f"{tag}: id 重复或保留({did})")
        ids.add(did)
        for ref in dg.get("hunks") or []:
            m = re.match(r"^(.+)#(\d+)$", str(ref))
            if not m or m.group(1) not in by_path or int(m.group(2)) >= len(by_path[m.group(1)]["hunks"]):
                problems.append(f"{tag}: hunks 里的 {ref!r} 不存在(格式 路径#序号)")
        if dg.get("kind", "d2") == "d2" and dg.get("src", "").strip():
            if not D2:
                problems.append(f"{tag}: d2 未安装, 没法校验(brew install d2)")
            else:
                err = d2_check(dg["src"])
                if err:
                    problems.append(f"{tag} ({dg.get('title')}): d2 编译失败 —— {err}")
    total = sum(len(f["hunks"]) for f in diff["files"])
    if problems:
        print("\n".join("✗ " + p for p in problems), file=sys.stderr)
        if not a.force:
            die("有问题, 没写入(加 --force 强行写)")
    write_json(d / "notes.json", notes)
    missing = [f"{p}#{i}" for p, f in by_path.items() for i in range(len(f["hunks"]))
               if str(i) not in (files.get(p, {}).get("hunks") or {})]
    ndg = len(dgs or [])
    print(f"已写入 notes.json: 说明 {covered} 个, 跳过 {skipped} 个, 共 {total} 个 hunk" + (f"; 图解 {ndg} 张" if ndg else "") + (f"; 还没说明的: {', '.join(missing[:12])}" + (" …" if len(missing) > 12 else "") if missing else ""))


def print_comments(comments, diff, json_out=False, header=None):
    if json_out:
        print(json.dumps(comments, ensure_ascii=False, indent=1))
        return
    if header:
        print(header)
    if not comments:
        print("(没有评论)")
        return
    status_cn = {"open": "未发送", "sent": "待处理", "replied": "已回复", "resolved": "已解决"}
    for c in comments:
        flag = (" ⚠ 行内容已变, 位置可能不准" if c.get("stale") else "") + ("  ✔ agent 已处理, 待用户确认" if c.get("agent_done") and c["status"] != "resolved" else "")
        print(f"\n[{c['id']}] {status_cn.get(c['status'], c['status'])}  {fmt_line_ref(c)}{flag}")
        if c["target"] == "line":
            h, ln = find_line(diff, c["file"], c["hunk"], c["side"], c["line"])
            if ln:
                print(f"    > {ln['t']}{ln['s']}")
            elif c.get("snippet") is not None:
                print(f"    > {c['snippet']}")
        elif c["target"] == "hunk":
            f = next((f for f in diff["files"] if f["path"] == c["file"]), None)
            if f and c["hunk"] < len(f["hunks"]):
                print(f"    > {f['hunks'][c['hunk']]['header']}")
        for line in c["body"].splitlines():
            print(f"    {line}")
        reps = c.get("replies", [])
        last_agent = max([i for i, r in enumerate(reps) if r["who"] == "agent"], default=-1)
        for i, r in enumerate(reps):
            who = "agent" if r["who"] == "agent" else ("我(新)" if i > last_agent else "我")
            first = True
            for line in r["body"].splitlines() or [""]:
                print(f"    {who + ':' if first else ' ' * (len(who) + 1)} {line}")
                first = False


