#!/bin/sh
# Shim: keeps ~/.config/bin/hudiff (a relative symlink) working while the Go
# rewrite lands. Replaced by the go build artifact in M6.
p=$0
while [ -L "$p" ]; do
    d=$(cd -P "$(dirname "$p")" && pwd)
    l=$(readlink "$p")
    case $l in
        /*) p=$l ;;
        *)  p=$d/$l ;;
    esac
done
d=$(cd -P "$(dirname "$p")" && pwd)
exec python3 "$d/legacy/hudiff.py" "$@"
