.rv-good{margin:0 0 16px;padding-left:22px;font-size:13px} .rv-good li{margin:2px 0} .rv-good li::marker{color:var(--ok)}
.rv-sec{margin:14px 0 6px;display:flex;gap:8px;align-items:center} .rv-sec h3{margin:0;font-size:13px;font-weight:650;text-transform:none;letter-spacing:0;color:var(--fg)}
.rv-sec .pr{font-size:11px;padding:1px 8px;border-radius:9px;font-weight:600} .pr.high{background:var(--del-bg);color:var(--del-fg)} .pr.medium{background:var(--warn-bg);color:var(--warn)} .pr.low{background:var(--accent-bg);color:var(--accent)}
.rv-sec .cnt{font-size:11.5px;color:var(--fg2)}
.rvi{display:grid;grid-template-columns:22px 1fr;gap:4px 10px;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px;background:var(--bg);box-shadow:var(--shadow);border-left:3px solid var(--line)}
.rvi.high{border-left-color:var(--del-fg)} .rvi.medium{border-left-color:var(--warn)} .rvi.low{border-left-color:var(--accent)}
.rvi.done,.rvi.wontfix{opacity:.62} .rvi.done .t,.rvi.wontfix .t{text-decoration:line-through}
.rvi .cb{width:18px;height:18px;border:1.5px solid var(--fg3);border-radius:5px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;margin-top:2px;user-select:none}
.rvi .cb:hover{border-color:var(--accent)} .rvi.done .cb{background:var(--ok);border-color:var(--ok)} .rvi.wontfix .cb{background:var(--fg3);border-color:var(--fg3)}
