# ─── main ────────────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(prog="hudiff", description="让 agent 讲解 diff, 在浏览器里逐行评论, 评论回流给 agent")
    ap.add_argument("--session", "-s", help="指定会话 id(默认最近一次 open 的)")
    ap.add_argument("--port", type=int, help="server 端口(只在需要拉起 server 时生效; 不给 = 沿用上次, 首次随机)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    # --session 放在子命令前后都行(子命令上的用 SUPPRESS, 免得 None 把全局的盖掉)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--session", "-s", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    _add = sub.add_parser
    sub.add_parser = lambda *a, **k: _add(*a, parents=[common], **k)

    p = sub.add_parser("open", help="取 diff, 起 server, 开浏览器")
    p.add_argument("target", nargs="*", help="<rev> | a..b | pr <n> | #<n> | PR URL; 空 = 工作区 vs HEAD")
    p.add_argument("--staged", action="store_true")
    p.add_argument("--unstaged", action="store_true")
    p.add_argument("--patch", help="补丁文件, '-' 读 stdin")
    p.add_argument("-t", "--title")
    p.add_argument("-p", "--prompt", help="审查要求 / 关注点, 原文给 agent('-' 读 stdin); 另有预设 ~/.config/hudiff/{default,<仓库名>}.md")
    p.add_argument("-c", "--context", action="append", help="给 agent 的上下文文件路径, 可重复(spec、issue、设计文档…)")
    p.add_argument("--no-browser", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--new", action="store_true", help="强制新建会话(默认同一个 commit/PR/区间/工作区复用已有会话)")
    p.set_defaults(fn=cmd_open)

    p = sub.add_parser("info", help="打印当前会话的信息(目录 / 地址 / 文件 / 审查要求), 机器可读")
    p.set_defaults(fn=cmd_info)

    p = sub.add_parser("serve", help="(内部) 前台跑 server, 管所有会话")
    p.add_argument("--port", type=int, help="监听端口; 不给 = 上次的端口, 首次随机")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("show", help="打印带 hunk 标记的 diff")
    p.add_argument("--file", "-f")
    p.add_argument("-W", "--func", action="store_true", help="每个 hunk 补出所在的整个顶层块(函数/类型/段落)")
    p.add_argument("-U", "--unified", type=int, metavar="N", help="每个 hunk 前后各补 N 行新版原文")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("diagram", help="图解: 列出 / 打印 d2 源码 / 渲染成 svg")
    p.add_argument("which", nargs="?", help="auto-map 或图的 id; 不给 = 列出")
    p.add_argument("--list", action="store_true")
    p.add_argument("--src", action="store_true", help="打印 d2 源码而不是渲染")
    p.add_argument("--theme", default="light", choices=["light", "dark"])
    p.add_argument("-o", "--out", help="svg 输出路径; 不给就写 stdout")
    p.set_defaults(fn=cmd_diagram)

    p = sub.add_parser("ctx", help="改动的仓库级上下文: 文件近史、改了哪些符号、谁在引用、相关测试")
    p.add_argument("--file", "-f")
    p.add_argument("--refs", type=int, default=6, help="每个符号最多列几处引用(默认 6)")
    p.set_defaults(fn=cmd_ctx)

    p = sub.add_parser("notes", help="校验并写入 agent 的说明 JSON")
    p.add_argument("path", help="notes.json 路径, '-' 读 stdin")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_notes)

    p = sub.add_parser("comments", help="列评论")
    p.add_argument("--new", action="store_true", help="只列已发给 agent 且未回复的")
    p.add_argument("--all", action="store_true", help="含已解决")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_comments)

    p = sub.add_parser("wait", help="等用户点「发给 agent」, 然后打印新评论")
    p.add_argument("--timeout", type=float, default=1800, help="秒, 默认 1800(30 分钟); 超时退出码 124")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("reply", help="agent 回复评论")
    p.add_argument("id")
    p.add_argument("text", help="回复内容, '-' 读 stdin")
    p.add_argument("--resolve", action="store_true", help="回复后标记「已处理, 待用户确认」(不关闭评论)")
    p.set_defaults(fn=cmd_reply)

    p = sub.add_parser("resolve", help="agent: 标记「已处理, 待用户确认」(不会关闭); --by user 才真正解决; --reopen 重开")
    p.add_argument("ids", nargs="+")
    p.add_argument("--reopen", action="store_true")
    p.add_argument("--by", default="agent", help="agent(默认) / user")
    p.set_defaults(fn=cmd_resolve)

    p = sub.add_parser("review", help="交叉审查报告: 列出 / set 写入 / done|wontfix|reopen 改状态 / md 导出")
    rs = p.add_subparsers(dest="rsub")
    q = rs.add_parser("set", help="写入报告 JSON(schema 见 skill); 默认【并入】已有报告, 老项和状态都保留"); q.add_argument("path", help="json 路径, '-' 读 stdin"); q.add_argument("--author", help="reviewer 标识"); q.add_argument("--force", action="store_true"); q.add_argument("--replace", action="store_true", help="整份覆盖(会丢掉之前的项和用户打的钩), 一般不用")
    for name, hp in (("done", "标记已处理"), ("wontfix", "标记不改"), ("reopen", "重开")):
        q = rs.add_parser(name, help=hp); q.add_argument("id"); q.add_argument("text", nargs="?", default="", help="处理结果 / 理由, '-' 读 stdin"); q.add_argument("--by", default="agent", help="agent(默认) 或 user")
    q = rs.add_parser("note", help="给某项追加复核 / 讨论说明(复审时对已处理、已拒绝的项必写)"); q.add_argument("id"); q.add_argument("text", help="内容, '-' 读 stdin"); q.add_argument("--verdict", default="info", choices=["ok", "disagree", "info"], help="ok=复核通过 / disagree=有异议 / info=补充"); q.add_argument("--by", default="reviewer", help="reviewer(默认) / agent / user")
    rs.add_parser("md", help="按模板导出 markdown")
    p.add_argument("--open", action="store_true", help="只列待处理的")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_review)

    p = sub.add_parser("refresh", help="重取 diff(代码改了之后), 评论按内容重新对位")
    p.set_defaults(fn=cmd_refresh)

    p = sub.add_parser("url", help="打印当前会话地址(server 不在就拉起)")
    p.add_argument("--home", action="store_true", help="打印首页(会话列表)地址")
    p.set_defaults(fn=cmd_url)
    p = sub.add_parser("ls", help="列所有会话")
    p.add_argument("--all", action="store_true", help="含已归档")
    p.set_defaults(fn=cmd_ls)
    p = sub.add_parser("archive", help="归档会话(首页不再列出, 数据保留); --undo 取消")
    p.add_argument("ids", nargs="+")
    p.add_argument("--undo", action="store_true")
    p.set_defaults(fn=cmd_archive)
    p = sub.add_parser("rm", help="删掉会话(含评论), 不可恢复")
    p.add_argument("ids", nargs="+")
    p.set_defaults(fn=cmd_rm)
    p = sub.add_parser("stop", help="停 server(唯一一个, 数据不删)")
    p.set_defaults(fn=cmd_stop)

    a = ap.parse_args()
    global WANT_PORT
    WANT_PORT = a.port
    if a.cmd != "serve" and a.port and server_alive() and server_info().get("port") != a.port:
        print(f"hudiff: server 已经在 {server_info()['port']} 端口跑着, --port {a.port} 没生效; 要换端口先 hudiff stop", file=sys.stderr)
    a.fn(a)


if __name__ == "__main__":
    main()
