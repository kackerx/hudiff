#lb img{position:absolute;left:0;top:0;transform-origin:0 0;max-width:none;background:#fff;border-radius:6px;box-shadow:0 8px 40px rgba(0,0,0,.5)}
.file-block{border-bottom:1px solid var(--line);content-visibility:auto;contain-intrinsic-size:auto 600px}
table.hunk{content-visibility:auto;contain-intrinsic-size:auto 300px}
.file-head{position:sticky;top:0;z-index:2;background:var(--bg2);border-bottom:1px solid var(--line);padding:7px 14px;display:flex;gap:10px;align-items:center;font-size:12.5px;cursor:pointer;user-select:none}
.file-head .tri{color:var(--fg3);font-size:10px;width:10px;transition:transform .12s} .file-block.collapsed .file-head .tri{transform:rotate(-90deg)}
.file-head .path{font-family:var(--mono);font-weight:600} .file-head .path .dir{color:var(--fg2);font-weight:400}
.file-head .st{font-size:10.5px;padding:1px 7px;border-radius:4px;background:var(--chip);color:var(--fg2);font-weight:500}
.file-head .st.A{background:var(--ok-bg);color:var(--ok)} .file-head .st.D{background:var(--del-bg);color:var(--del-fg)} .file-head .st.R{background:var(--accent-bg);color:var(--accent)}
.file-head .fsum{font-size:12px;color:var(--fg2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.file-head .pm{margin-left:auto;font-size:11px;font-family:var(--mono);white-space:nowrap}
.file-block.collapsed table.hunk,.file-block.collapsed .binhint{display:none}
table.hunk{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px;line-height:20px;table-layout:fixed}
table.hunk td{padding:0;vertical-align:top}
tr.hh td{background:var(--hunk-bg);color:var(--hunk-fg);padding:3px 14px;white-space:pre-wrap;word-break:break-all;font-size:11.5px;border-top:1px solid var(--line2);border-bottom:1px solid var(--line2)}
tr.hh td .hno{display:inline-block;font-size:10px;padding:0 6px;border-radius:9px;background:var(--accent-bg);color:var(--accent);margin-right:8px;font-weight:600;font-family:var(--sans)}
