def _patch_direct(d, cid, fields):
    comments = read_json(d / "comments.json", [])
    c = next((c for c in comments if c["id"] == cid), None) or die(f"没有评论 {cid}")
    c.update(fields)
    write_json(d / "comments.json", comments)
    return c


def _review_item_direct(d, rid, fields):
    rv = load_review(d) or die("还没有审查报告")
    it = next((x for x in rv.get("items", []) if x["id"] == rid), None) or die(f"没有审查项 {rid}")
    it.update(fields)
    write_json(d / "review.json", rv)
    return it


def print_review(rv, only_open=False, json_out=False):
    if json_out:
        print(json.dumps(rv, ensure_ascii=False, indent=1)); return
    c = review_counts(rv)
    rounds = rv.get("rounds") or []
    print(f"# 审查报告  作者 {rv.get('author', '?')}  {rv.get('updated', '')}   共 {len(rounds) or 1} 轮   待处理 {c['open']}(高 {c['high']} / 中 {c['medium']} / 低 {c['low']})  已处理 {c['done']}  拒绝 {c['wontfix']}")
    if not only_open:
        if len(rounds) > 1:
            print("\n## 各轮总评")
            for r in rounds:
                print(f"- 第 {r['round']} 轮 {r.get('author', '?')} {str(r.get('at', ''))[:16]}: 新增 {r.get('added', 0)} 项 —— {r.get('summary', '').strip()}")
        else:
            print(f"\n## 总体评价\n{rv.get('summary', '').strip()}")
        if rv.get("strengths"):
            print("\n## 优点\n" + "\n".join("- " + x for x in rv["strengths"]))
    print("\n## 待处理项")
    for pr in ("high", "medium", "low"):
        its = [it for it in rv.get("items", []) if it["priority"] == pr and (not only_open or it.get("status", "open") == "open")]
        if not its:
            continue
        print(f"\n### [{PRIO[pr]}]")
        for it in its:
            mark = {"open": "[ ]", "done": "[x]", "wontfix": "[~]"}[it.get("status", "open")] + (f" R{it['round']}" if it.get("round") and len(rounds) > 1 else "")
            loc = (f"  {it['file']}" + (f"  {'新版' if it.get('side', 'new') == 'new' else '旧版'} L{it['line']}" if it.get("line") else "") + (f"  (hunk {it['hunk']})" if it.get("hunk") is not None else "")) if it.get("file") else ""
            print(f"\n{mark} {it['id']}  {it['title']}{loc}")
            if it.get("snippet"):
                print(f"    > {it['snippet']}")
            for line in (it.get("body") or "").strip().splitlines():
                print(f"    {line}")
            if it.get("suggestion"):
                print("    建议: " + it["suggestion"].strip().replace("\n", "\n    "))
            if it.get("resolution"):
                print(f"    {'✘ 拒绝理由' if it.get('status') == 'wontfix' else '✔ 处理结果'}({it.get('resolved_by', '')}): {it['resolution']}")
            for n in it.get("notes", []):
                mark = {"ok": "✓ 复核通过", "disagree": "⚠ 有异议", "info": "· 说明"}.get(n.get("verdict"), "·")
                print(f"    {mark} [{n.get('who', '')} R{n.get('round', '?')}] {n['body']}")


def cmd_review(a):
    sid, d = current_session(a.session)
    sess, diff, notes, _ = load(d)
    sub = a.rsub
    if sub == "set":
        text = sys.stdin.read() if a.path == "-" else Path(a.path).read_text()
        try:
            rv = json.loads(text)
        except json.JSONDecodeError as e:
            die(f"不是合法 JSON: {e}")
        rv.setdefault("author", a.author or "reviewer")
        problems, rv = validate_review(rv, diff)
        if problems:
            print("\n".join("✗ " + p for p in problems), file=sys.stderr)
            if not a.force:
                die("有问题, 没写入(加 --force 强行写)")
        qs = "&".join(x for x in (("force=1" if a.force else ""), ("replace=1" if a.replace else "")) if x)
        r = api(sid, "POST", "/api/review" + ("?" + qs if qs else ""), rv)
        if r is None:
            rv = merge_review(load_review(d), rv, replace=a.replace)
            rv["updated"] = now_iso()
            write_json(d / "review.json", rv)
            m = rv.get("_merge")
        else:
            m = r.get("merge")
            rv = load_review(d)
        c = review_counts(rv)
        if m:
            print(f"第 {m['round']} 轮已并入: 新增 {m['added']} 项, 更新 {m['updated']} 项, 复核说明 {m.get('noted', 0)} 条, 保留之前的 {m['kept']} 项及其状态; 现在共 {len(rv['items'])} 项, 待处理 {c['open']}(高 {c['high']} / 中 {c['medium']} / 低 {c['low']})")
        else:
            print(f"已写入审查报告: {len(rv['items'])} 项(高 {c['high']} / 中 {c['medium']} / 低 {c['low']})")
        print("在 wait 的 agent 已被叫醒")
        return
    rv = load_review(d)
    if sub in ("done", "wontfix", "reopen"):
        if not rv:
            die("还没有审查报告")
        st = {"done": "done", "wontfix": "wontfix", "reopen": "open"}[sub]
        text = (a.text or "")
        if text == "-":
            text = sys.stdin.read()
        if st != "open" and not text.strip():
            die("要写处理结果(做了什么 / 为什么不改)")
        fields = {"status": st, "resolution": text.strip(), "by": a.by}
        r = api(sid, "PATCH", f"/api/review/{a.id}", fields)
        if r is None:
            direct = {"status": st}
            if st != "open":
                direct.update(resolution=text.strip(), resolved_by=a.by, resolved_at=now_iso())
            _review_item_direct(d, a.id, direct)
        print(f"{a.id} → {st}")
        return
    if sub == "note":
        if not rv:
            die("还没有审查报告")
        text = sys.stdin.read() if a.text == "-" else a.text
        body = {"body": text.strip(), "who": a.by, "verdict": a.verdict}
        r = api(sid, "POST", f"/api/review/{a.id}/note", body)
        if r is None:
            it = next((x for x in rv.get("items", []) if x["id"] == a.id), None) or die(f"没有审查项 {a.id}")
            it.setdefault("notes", []).append(dict(who=a.by, round=len(rv.get("rounds") or []) or 1, body=text.strip(), verdict=a.verdict, ts=now_iso()))
            write_json(d / "review.json", rv)
        print(f"{a.id} ← 复核说明({a.verdict})")
        return
    if sub == "md":
        if not rv:
            die("还没有审查报告")
        print(review_markdown(rv, diff))
        return
    # 默认: 列出
    if not rv:
        print("(还没有审查报告 —— 让另一个 agent 跑 /hudiff review <会话id>)")
        return
    print_review(rv, only_open=a.open, json_out=a.json)


