.dgcard{display:flex;flex-direction:column;border:1px solid var(--note-border);border-radius:10px;background:var(--note-bg);margin-bottom:8px;cursor:pointer;overflow:hidden;box-shadow:var(--shadow);border-left:3px solid var(--line)}
.dgcard:hover{border-color:var(--accent)} .dgcard.active{border-left-color:var(--accent)}
.dgcard .th{height:96px;background:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden;border-bottom:1px solid var(--line2)}
.dgcard .th img{max-width:92%;max-height:88px;object-fit:contain}
.dgcard .tt{padding:6px 10px;font-size:12.5px;font-weight:600;display:flex;gap:6px;align-items:center} .dgcard .tt .hint{font-weight:400;margin-left:auto;white-space:nowrap}
.card .dgl{cursor:pointer} .card .dgl:hover{background:var(--accent);color:#fff}
#lb{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.72);display:flex;flex-direction:column}
#lb .lbbar{display:flex;gap:14px;align-items:center;padding:8px 16px;background:var(--bg2);border-bottom:1px solid var(--line);color:var(--fg);font-size:13px;font-weight:600} #lb .lbbar .hint{font-weight:400;margin-left:auto}
